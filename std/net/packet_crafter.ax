// Axiom Standard Library - Raw Network Packet Crafter (std:net:packet_crafter)
// std/net/packet_crafter.ax

fn craft_ipv4_header(src_ip: str, dst_ip: str, protocol: int, payload_len: int) -> str
    requires len(src_ip) > 0
    requires len(dst_ip) > 0
    requires protocol >= 0 and protocol <= 255
{
    return rt_packet_craft_ip(src_ip, dst_ip, protocol, payload_len)
}

fn craft_tcp_syn(src_ip: str, dst_ip: str, src_port: int, dst_port: int) -> str
    requires src_port > 0 and src_port <= 65535
    requires dst_port > 0 and dst_port <= 65535
{
    // TCP SYN flag is 0x02
    return rt_packet_craft_tcp(src_ip, dst_ip, src_port, dst_port, 1000, 2)
}

fn craft_tcp_custom(src_ip: str, dst_ip: str, src_port: int, dst_port: int, seq: int, flags: int) -> str
    requires src_port > 0 and src_port <= 65535
    requires dst_port > 0 and dst_port <= 65535
{
    return rt_packet_craft_tcp(src_ip, dst_ip, src_port, dst_port, seq, flags)
}

fn craft_udp_packet(src_port: int, dst_port: int, payload: str) -> str
    requires src_port > 0 and src_port <= 65535
    requires dst_port > 0 and dst_port <= 65535
{
    return rt_packet_craft_udp(src_port, dst_port, payload)
}
