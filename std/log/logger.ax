// Axiom Standard Library (std) - Leveled & Colored Logger Engine
// std:log:logger

fn log_set_level(level: int) -> void {
    rt_log_set_level(level)
}

fn log_debug(module: str, msg: str) -> void {
    rt_log_debug(module, msg)
}

fn log_info(module: str, msg: str) -> void {
    rt_log_info(module, msg)
}

fn log_warn(module: str, msg: str) -> void {
    rt_log_warn(module, msg)
}

fn log_error(module: str, msg: str) -> void {
    rt_log_error(module, msg)
}
