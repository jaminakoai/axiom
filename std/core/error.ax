// Axiom Standard Library: std/core/error
//
// Result<T, E> ve `?` operatoru icin kanonik tip.
//
//   import "std/core/error"
//
//   fn oku(yol: str) -> Result<str, str> {
//       let icerik = read_file(yol)?
//       return result_ok<str>(icerik)
//   }
//
// `?` operatoru soz dizimi: <ifade>?
//   - <ifade> Result benzeri olmali (is_ok: bool, value: T, error: E)
//   - iceren fonksiyon Result<_, E> dondurmeli
//   - Ok ise T degeri uretir; Err ise hatayi ust katmana iletir (defer'ler calisir)
//
// Not: Yapi alan adlari (is_ok/value/error) sabittir; `?` bunlari arar.

struct Result<T, E> {
    is_ok: bool,
    value: T,
    error: E
}

// --- Kurucular ---
//
// `result_ok<T>(v)` T'yi argumandan cikarir.
// Hata kuruculari icin T argumandan cikarilamaz (tek arguman `str`), bu yuzden
// her yaygin tip icin ayri kurucu vardir. Kendi tipiniz icin
// `result_err_with<T>(msg, empty)` kullanin.

fn result_ok<T>(v: T) -> Result<T, str> {
    return Result<T, str> { is_ok: true, value: v, error: "" };
}

// Genel hata kurucusu: Err durumunda tasinacak "bos" degeri acikca verir.
fn result_err_with<T>(msg: str, empty: T) -> Result<T, str> {
    return Result<T, str> { is_ok: false, value: empty, error: msg };
}

fn result_err_int(msg: str) -> Result<int, str> {
    return Result<int, str> { is_ok: false, value: 0, error: msg };
}

fn result_err_str(msg: str) -> Result<str, str> {
    return Result<str, str> { is_ok: false, value: "", error: msg };
}

fn result_err_bool(msg: str) -> Result<bool, str> {
    return Result<bool, str> { is_ok: false, value: false, error: msg };
}

fn result_err_strs(msg: str) -> Result<str[], str> {
    let empty: str[] = []
    return Result<str[], str> { is_ok: false, value: empty, error: msg };
}

// --- Sorgular ---

fn result_is_ok<T>(r: Result<T, str>) -> bool {
    return r.is_ok;
}

fn result_is_err<T>(r: Result<T, str>) -> bool {
    return not r.is_ok;
}

fn result_error<T>(r: Result<T, str>) -> str {
    verify not r.is_ok, "result_error yalnizca Err uzerinde cagrilabilir";
    return r.error;
}

// --- Cozumleme ---

fn result_unwrap<T>(r: Result<T, str>) -> T {
    verify r.is_ok, "Result::unwrap basarisiz (Err degeri)";
    return r.value;
}

fn result_unwrap_or<T>(r: Result<T, str>, fallback: T) -> T {
    if r.is_ok {
        return r.value;
    }
    return fallback;
}

fn result_expect<T>(r: Result<T, str>, msg: str) -> T {
    verify r.is_ok, "Result::expect basarisiz";
    return r.value;
}
