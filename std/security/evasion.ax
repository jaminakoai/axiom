// Axiom Standard Library - Environment Diagnostics & Anti-Analysis (std:security:evasion)
// std/security/evasion.ax

fn evasion_is_debugger_present() -> bool {
    return rt_diag_is_debugged()
}

fn evasion_is_vm_or_sandbox() -> bool {
    return rt_diag_is_virtualized()
}

fn evasion_disable_core_dump() -> void {
    rt_diag_set_dumpable(false)
}

fn evasion_enable_core_dump() -> void {
    rt_diag_set_dumpable(true)
}
