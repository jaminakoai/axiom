// YARA condition-expression subset: pattern groups and references, filesize
// comparisons, constants, not/and/or, and parentheses.
// A precedence parser keeps operator semantics explicit and rejects unknown
// identifiers instead of coercing them to an any-pattern condition.

struct YaraConditionParse {
    value: bool,
    position: int,
    valid: bool,
    witness_name: str,
    witness_offset: int
}

struct YaraConditionNumber {
    value: int,
    position: int,
    valid: bool
}

struct YaraConditionTextPattern {
    text: str,
    flags: int,
    valid: bool
}

struct YaraConditionRange {
    min_offset: int,
    max_offset: int,
    position: int,
    restricted: bool,
    valid: bool
}

fn _yc_is_word_char(ch: str) -> bool {
    return str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", ch)
}

fn _yc_skip_space(source: str, position: int) -> int {
    let mut i = position
    while i < str_byte_len(source) {
        let ch = str_char_at(source, i)
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            i = i + 1
        } else {
            return i
        }
    }
    return i
}

fn _yc_keyword_at(source: str, position: int, keyword: str) -> bool {
    let n = str_byte_len(source)
    let size = str_byte_len(keyword)
    if position < 0 or position + size > n { return false }
    if str_sub(source, position, size) != keyword { return false }
    let after = position + size
    if after < n and _yc_is_word_char(str_char_at(source, after)) { return false }
    return true
}

fn _yc_hex_digit(ch: str) -> int {
    if str_contains("0123456789", ch) { return str_to_int(ch) }
    let mut letter_index = str_index_of("abcdef", ch)
    if letter_index < 0 { letter_index = str_index_of("ABCDEF", ch) }
    if letter_index >= 0 { return letter_index + 10 }
    return -1
}

fn _yc_parse_number(source: str, position: int) -> YaraConditionNumber {
    let start = _yc_skip_space(source, position)
    let n = str_byte_len(source)
    let mut hex_prefix = false
    if start + 2 <= n {
        let prefix = str_sub(source, start, 2)
        hex_prefix = prefix == "0x" or prefix == "0X"
    }
    if hex_prefix {
        let mut i = start + 2
        let mut hex_value = 0
        while i < n {
            let digit = _yc_hex_digit(str_char_at(source, i))
            if digit < 0 { break }
            if hex_value > 576460752303423487 {
                return YaraConditionNumber { value: 0, position: i, valid: false }
            }
            hex_value = hex_value * 16 + digit
            i = i + 1
        }
        return YaraConditionNumber { value: hex_value, position: i, valid: i > start + 2 }
    }
    let mut end = start
    let mut decimal_value = 0
    while end < n and str_contains("0123456789", str_char_at(source, end)) {
        let digit = str_to_int(str_char_at(source, end))
        if decimal_value > 922337203685477580 or (decimal_value == 922337203685477580 and digit > 7) {
            return YaraConditionNumber { value: 0, position: end, valid: false }
        }
        decimal_value = decimal_value * 10 + digit
        end = end + 1
    }
    if end == start { return YaraConditionNumber { value: 0, position: start, valid: false } }
    return YaraConditionNumber {
        value: decimal_value,
        position: end,
        valid: true
    }
}

fn _yc_pattern_find_in_range(pattern: str, target: str, min_offset: int, max_offset: int, target_buffer: int) -> int {
    if str_starts_with(pattern, "regex:") { return -1 }
    if str_starts_with(pattern, "str:") {
        let mut p = str_sub(pattern, 4, str_len(pattern) - 4)
        let mut flags = 0
        if str_starts_with(pattern, "str:nocase:") {
            p = str_sub(pattern, len("str:nocase:"), str_len(pattern) - len("str:nocase:"))
            flags = 1
        } else if str_starts_with(pattern, "str:flags:") {
            let rest = str_sub(pattern, len("str:flags:"), str_len(pattern) - len("str:flags:"))
            let separator = str_index_of(rest, ":")
            if separator < 0 { return -1 }
            flags = str_to_int(str_sub(rest, 0, separator))
            p = str_sub(rest, separator + 1, str_len(rest) - separator - 1)
        }
        if target_buffer > 0 {
            return rt_yara_find_text_buf_handle(target_buffer, p, flags, min_offset, max_offset)
        }
        return rt_yara_find_text(target, p, flags, min_offset, max_offset)
    }
    if str_starts_with(pattern, "hexast:v1:") or str_starts_with(pattern, "hex:") or str_starts_with(pattern, "hexrange:") or str_starts_with(pattern, "hexalt:") or str_starts_with(pattern, "hexnot:") {
        if target_buffer > 0 {
            return rt_yara_find_hex_pattern_buf_handle(target_buffer, pattern, min_offset, max_offset)
        }
        return rt_yara_find_hex_pattern(target, pattern, min_offset, max_offset)
    }
    return -1
}

fn _yc_pattern_matches_in_range(pattern: str, target: str, min_offset: int, max_offset: int, target_buffer: int) -> bool {
    return _yc_pattern_find_in_range(pattern, target, min_offset, max_offset, target_buffer) >= 0
}

fn _yc_text_pattern_parts(pattern: str) -> YaraConditionTextPattern {
    if not str_starts_with(pattern, "str:") {
        return YaraConditionTextPattern { text: "", flags: 0, valid: false }
    }
    let mut text = str_sub(pattern, 4, str_len(pattern) - 4)
    let mut flags = 0
    if str_starts_with(pattern, "str:nocase:") {
        text = str_sub(pattern, len("str:nocase:"), str_len(pattern) - len("str:nocase:"))
        flags = 1
    } else if str_starts_with(pattern, "str:flags:") {
        let rest = str_sub(pattern, len("str:flags:"), str_len(pattern) - len("str:flags:"))
        let separator = str_index_of(rest, ":")
        if separator < 0 { return YaraConditionTextPattern { text: "", flags: 0, valid: false } }
        flags = str_to_int(str_sub(rest, 0, separator))
        text = str_sub(rest, separator + 1, str_len(rest) - separator - 1)
    }
    return YaraConditionTextPattern { text: text, flags: flags, valid: true }
}

fn _yc_compare_int(left: int, op: str, right: int) -> bool {
    if op == "<" { return left < right }
    if op == "<=" { return left <= right }
    if op == ">" { return left > right }
    if op == ">=" { return left >= right }
    if op == "==" { return left == right }
    if op == "!=" { return left != right }
    return false
}

fn _yc_parse_range_suffix(source: str, position: int) -> YaraConditionRange {
    let n = str_byte_len(source)
    let start = _yc_skip_space(source, position)
    if _yc_keyword_at(source, start, "at") {
        let offset = _yc_parse_number(source, start + 2)
        if not offset.valid {
            return YaraConditionRange { min_offset: 0, max_offset: 0, position: offset.position, restricted: true, valid: false }
        }
        return YaraConditionRange { min_offset: offset.value, max_offset: offset.value, position: offset.position, restricted: true, valid: true }
    }
    if _yc_keyword_at(source, start, "in") {
        let open = _yc_skip_space(source, start + 2)
        if open >= n or str_char_at(source, open) != "(" {
            return YaraConditionRange { min_offset: 0, max_offset: 0, position: open, restricted: true, valid: false }
        }
        let lower = _yc_parse_number(source, open + 1)
        if not lower.valid {
            return YaraConditionRange { min_offset: 0, max_offset: 0, position: lower.position, restricted: true, valid: false }
        }
        let dots = _yc_skip_space(source, lower.position)
        if dots + 1 >= n or str_sub(source, dots, 2) != ".." {
            return YaraConditionRange { min_offset: 0, max_offset: 0, position: dots, restricted: true, valid: false }
        }
        let upper = _yc_parse_number(source, dots + 2)
        if not upper.valid or upper.value < lower.value {
            return YaraConditionRange { min_offset: 0, max_offset: 0, position: upper.position, restricted: true, valid: false }
        }
        let close = _yc_skip_space(source, upper.position)
        if close >= n or str_char_at(source, close) != ")" {
            return YaraConditionRange { min_offset: 0, max_offset: 0, position: close, restricted: true, valid: false }
        }
        return YaraConditionRange { min_offset: lower.value, max_offset: upper.value, position: close + 1, restricted: true, valid: true }
    }
    return YaraConditionRange { min_offset: 0, max_offset: 0, position: position, restricted: false, valid: true }
}

fn _yc_group_pattern_matches(pattern: str, is_present: bool, restricted: bool, min_offset: int, max_offset: int, target: str, target_size: int, target_buffer: int) -> bool {
    if not restricted { return is_present }
    if target_size < 0 { return false }
    return _yc_pattern_matches_in_range(pattern, target, min_offset, max_offset, target_buffer)
}

fn _yc_parse_group(source: str, position: int, pattern_names: str[], pattern_values: bool[], pattern_patterns: str[], target: str, target_size: int, target_buffer: int) -> YaraConditionParse {
    let n = str_byte_len(source)
    let mut mode = ""
    let mut threshold = 0
    let mut cursor = position
    if _yc_keyword_at(source, cursor, "any") {
        mode = "any"
        cursor = cursor + 3
    } else if _yc_keyword_at(source, cursor, "all") {
        mode = "all"
        cursor = cursor + 3
    } else if _yc_keyword_at(source, cursor, "none") {
        mode = "none"
        cursor = cursor + 4
    } else {
        let amount = _yc_parse_number(source, cursor)
        if not amount.valid {
            return YaraConditionParse { value: false, position: cursor, valid: false, witness_name: "", witness_offset: -1 }
        }
        mode = "count"
        threshold = amount.value
        cursor = amount.position
    }

    cursor = _yc_skip_space(source, cursor)
    if not _yc_keyword_at(source, cursor, "of") {
        return YaraConditionParse { value: false, position: cursor, valid: false, witness_name: "", witness_offset: -1 }
    }
    cursor = _yc_skip_space(source, cursor + 2)
    if _yc_keyword_at(source, cursor, "them") {
        let range = _yc_parse_range_suffix(source, cursor + 4)
        if not range.valid {
            return YaraConditionParse { value: false, position: range.position, valid: false, witness_name: "", witness_offset: -1 }
        }
        let mut group_selected_count = 0
        let mut group_match_count = 0
        let mut group_pattern_index = 0
        while group_pattern_index < len(pattern_names) {
            group_selected_count = group_selected_count + 1
            let mut present = false
            if group_pattern_index < len(pattern_values) {
                present = pattern_values[group_pattern_index]
            }
            if group_pattern_index < len(pattern_patterns) {
                if range.restricted and str_starts_with(pattern_patterns[group_pattern_index], "regex:") {
                    return YaraConditionParse { value: false, position: cursor, valid: false, witness_name: "", witness_offset: -1 }
                }
                if _yc_group_pattern_matches(pattern_patterns[group_pattern_index], present, range.restricted, range.min_offset, range.max_offset, target, target_size, target_buffer) {
                    group_match_count = group_match_count + 1
                }
            }
            group_pattern_index = group_pattern_index + 1
        }
        let mut group_result = false
        if mode == "any" { group_result = group_match_count > 0 }
        else if mode == "all" { group_result = group_match_count == group_selected_count }
        else if mode == "none" { group_result = group_match_count == 0 }
        else if mode == "count" {
            if threshold == 0 { group_result = group_match_count == 0 }
            else { group_result = group_match_count >= threshold }
        }
        return YaraConditionParse { value: group_result, position: range.position, valid: true, witness_name: "", witness_offset: -1 }
    }
    if cursor >= n or str_char_at(source, cursor) != "(" {
        return YaraConditionParse { value: false, position: cursor, valid: false, witness_name: "", witness_offset: -1 }
    }
    let selector_start = _yc_skip_space(source, cursor + 1)
    let mut close = selector_start
    let mut selector_valid = true
    let mut selectors = 0
    while selector_valid {
        close = _yc_skip_space(source, close)
        if close >= n or str_char_at(source, close) != "$" {
            selector_valid = false
            break
        }
        let name_start = close
        close = close + 1
        while close < n and _yc_is_word_char(str_char_at(source, close)) {
            close = close + 1
        }
        if close == name_start + 1 {
            selector_valid = false
            break
        }
        if close < n and str_char_at(source, close) == "*" { close = close + 1 }
        selectors = selectors + 1
        close = _yc_skip_space(source, close)
        if close < n and str_char_at(source, close) == "," {
            close = close + 1
        } else {
            if close >= n or str_char_at(source, close) != ")" { selector_valid = false }
            break
        }
    }
    if not selector_valid or selectors == 0 {
        return YaraConditionParse { value: false, position: close, valid: false, witness_name: "", witness_offset: -1 }
    }

    // Every selector must resolve to at least one declared pattern. The
    // second pass computes the union, so overlapping wildcard selectors never
    // count the same pattern twice.
    let mut selector_cursor = selector_start
    let mut resolved_selector_count = 0
    while resolved_selector_count < selectors {
        selector_cursor = _yc_skip_space(source, selector_cursor)
        let selector_begin = selector_cursor
        selector_cursor = selector_cursor + 1
        while selector_cursor < n and _yc_is_word_char(str_char_at(source, selector_cursor)) {
            selector_cursor = selector_cursor + 1
        }
        let selector = str_sub(source, selector_begin, selector_cursor - selector_begin)
        let mut has_wildcard = false
        if selector_cursor < n and str_char_at(source, selector_cursor) == "*" {
            has_wildcard = true
            selector_cursor = selector_cursor + 1
        }
        let mut found_selector = false
        let mut candidate_pattern_index = 0
        while candidate_pattern_index < len(pattern_names) {
            let matches_selector = pattern_names[candidate_pattern_index] == selector
            let mut matches = matches_selector
            if has_wildcard { matches = str_starts_with(pattern_names[candidate_pattern_index], selector) }
            if matches { found_selector = true }
            candidate_pattern_index = candidate_pattern_index + 1
        }
        if not found_selector {
            return YaraConditionParse { value: false, position: selector_begin, valid: false, witness_name: "", witness_offset: -1 }
        }
        selector_cursor = _yc_skip_space(source, selector_cursor)
        if selector_cursor < n and str_char_at(source, selector_cursor) == "," {
            selector_cursor = selector_cursor + 1
        }
        resolved_selector_count = resolved_selector_count + 1
    }

    let range = _yc_parse_range_suffix(source, close + 1)
    if not range.valid {
        return YaraConditionParse { value: false, position: range.position, valid: false, witness_name: "", witness_offset: -1 }
    }
    let mut group_selected_count = 0
    let mut group_match_count = 0
    let mut group_pattern_index = 0
    while group_pattern_index < len(pattern_names) {
        let mut included = false
        selector_cursor = selector_start
        let mut selector_index_in_group = 0
        while selector_index_in_group < selectors {
            selector_cursor = _yc_skip_space(source, selector_cursor)
            let selector_begin = selector_cursor
            selector_cursor = selector_cursor + 1
            while selector_cursor < n and _yc_is_word_char(str_char_at(source, selector_cursor)) {
                selector_cursor = selector_cursor + 1
            }
            let selector = str_sub(source, selector_begin, selector_cursor - selector_begin)
            let mut matches = pattern_names[group_pattern_index] == selector
            if selector_cursor < n and str_char_at(source, selector_cursor) == "*" {
                matches = str_starts_with(pattern_names[group_pattern_index], selector)
                selector_cursor = selector_cursor + 1
            }
            if matches { included = true }
            selector_cursor = _yc_skip_space(source, selector_cursor)
            if selector_cursor < n and str_char_at(source, selector_cursor) == "," {
                selector_cursor = selector_cursor + 1
            }
            selector_index_in_group = selector_index_in_group + 1
        }
        if included {
            group_selected_count = group_selected_count + 1
            // Keep the bounds check separate: the LLVM backend may evaluate
            // both sides of `and`, which would index an empty/short array.
            if group_pattern_index < len(pattern_patterns) {
                let mut present = false
                if group_pattern_index < len(pattern_values) { present = pattern_values[group_pattern_index] }
                if range.restricted and str_starts_with(pattern_patterns[group_pattern_index], "regex:") {
                    return YaraConditionParse { value: false, position: close, valid: false, witness_name: "", witness_offset: -1 }
                }
                if _yc_group_pattern_matches(pattern_patterns[group_pattern_index], present, range.restricted, range.min_offset, range.max_offset, target, target_size, target_buffer) {
                    group_match_count = group_match_count + 1
                }
            }
        }
        group_pattern_index = group_pattern_index + 1
    }
    if group_selected_count == 0 {
        return YaraConditionParse { value: false, position: selector_start, valid: false, witness_name: "", witness_offset: -1 }
    }
    let mut group_result = false
    if mode == "any" { group_result = group_match_count > 0 }
    else if mode == "all" { group_result = group_match_count == group_selected_count }
    else if mode == "none" { group_result = group_match_count == 0 }
    else if mode == "count" {
        if threshold == 0 { group_result = group_match_count == 0 }
        else { group_result = group_match_count >= threshold }
    }
    return YaraConditionParse { value: group_result, position: range.position, valid: true, witness_name: "", witness_offset: -1 }
}

fn _yc_parse_primary(source: str, position: int, pattern_names: str[], pattern_values: bool[], pattern_counts: int[], pattern_patterns: str[], target: str, target_size: int, target_buffer: int) -> YaraConditionParse {
    let i = _yc_skip_space(source, position)
    let n = str_byte_len(source)
    if i >= n {
        return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 }
    }

    let ch = str_char_at(source, i)
    if ch == "(" {
        let inner = _yc_parse_or(source, i + 1, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size, target_buffer)
        if not inner.valid { return inner }
        let close = _yc_skip_space(source, inner.position)
        if close >= n or str_char_at(source, close) != ")" {
            return YaraConditionParse { value: false, position: close, valid: false, witness_name: "", witness_offset: -1 }
        }
        return YaraConditionParse { value: inner.value, position: close + 1, valid: true, witness_name: inner.witness_name, witness_offset: inner.witness_offset }
    }

    if _yc_keyword_at(source, i, "any") or _yc_keyword_at(source, i, "all") or _yc_keyword_at(source, i, "none") or str_contains("0123456789", ch) {
        return _yc_parse_group(source, i, pattern_names, pattern_values, pattern_patterns, target, target_size, target_buffer)
    }

    if ch == "@" or ch == "!" {
        let get_length = ch == "!"
        let mut name_end = i + 1
        while name_end < n and _yc_is_word_char(str_char_at(source, name_end)) { name_end = name_end + 1 }
        if name_end == i + 1 { return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 } }
        let name = "$" + str_sub(source, i + 1, name_end - i - 1)
        let mut found = -1
        let mut p = 0
        while p < len(pattern_names) {
            if pattern_names[p] == name { found = p }
            p = p + 1
        }
        if found < 0 or found >= len(pattern_patterns) {
            return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 }
        }
        let pattern_source = pattern_patterns[found]
        let is_text = str_starts_with(pattern_source, "str:")
        let is_hex = str_starts_with(pattern_source, "hexast:v1:") or str_starts_with(pattern_source, "hex:") or str_starts_with(pattern_source, "hexrange:") or str_starts_with(pattern_source, "hexalt:") or str_starts_with(pattern_source, "hexnot:")
        if not is_text and not is_hex {
            return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 }
        }
        let text_pattern = _yc_text_pattern_parts(pattern_source)
        if is_text and not text_pattern.valid {
            return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 }
        }
        let open = _yc_skip_space(source, name_end)
        if open >= n or str_char_at(source, open) != "[" {
            return YaraConditionParse { value: false, position: open, valid: false, witness_name: "", witness_offset: -1 }
        }
        let occurrence = _yc_parse_number(source, open + 1)
        if not occurrence.valid or occurrence.value <= 0 {
            return YaraConditionParse { value: false, position: occurrence.position, valid: false, witness_name: "", witness_offset: -1 }
        }
        let bracket = _yc_skip_space(source, occurrence.position)
        if bracket >= n or str_char_at(source, bracket) != "]" {
            return YaraConditionParse { value: false, position: bracket, valid: false, witness_name: "", witness_offset: -1 }
        }
        let op_start = _yc_skip_space(source, bracket + 1)
        let mut op = ""
        let mut op_len = 0
        if op_start + 1 < n {
            let pair = str_sub(source, op_start, 2)
            if pair == "<=" or pair == ">=" or pair == "==" or pair == "!=" {
                op = pair
                op_len = 2
            }
        }
        if op_len == 0 and op_start < n {
            let single = str_char_at(source, op_start)
            if single == "<" or single == ">" {
                op = single
                op_len = 1
            }
        }
        if op_len == 0 { return YaraConditionParse { value: false, position: op_start, valid: false, witness_name: "", witness_offset: -1 } }
        let expected = _yc_parse_number(source, op_start + op_len)
        if not expected.valid { return YaraConditionParse { value: false, position: expected.position, valid: false, witness_name: "", witness_offset: -1 } }
        let mut actual = -1
        if target_size >= 0 {
            let mut offset = -1
            if is_text {
                if target_buffer > 0 {
                    offset = rt_yara_nth_text_offset_buf_handle(target_buffer, text_pattern.text, text_pattern.flags, occurrence.value)
                } else {
                    offset = rt_yara_nth_text_offset(target, text_pattern.text, text_pattern.flags, occurrence.value)
                }
            } else {
                if target_buffer > 0 {
                    offset = rt_yara_nth_hex_pattern_offset_buf_handle(target_buffer, pattern_source, occurrence.value)
                } else {
                    offset = rt_yara_nth_hex_pattern_offset(target, pattern_source, occurrence.value)
                }
            }
            if offset >= 0 {
                actual = offset
                if get_length {
                    if is_text {
                        if target_buffer > 0 {
                            actual = rt_yara_nth_text_length_buf_handle(target_buffer, text_pattern.text, text_pattern.flags, occurrence.value)
                        } else {
                            actual = str_byte_len(text_pattern.text)
                        }
                    } else if target_buffer > 0 {
                        actual = rt_yara_nth_hex_pattern_length_buf_handle(target_buffer, pattern_source, occurrence.value)
                    } else {
                        actual = rt_yara_nth_hex_pattern_length(target, pattern_source, occurrence.value)
                    }
                }
            }
        }
        let matched = actual >= 0 and _yc_compare_int(actual, op, expected.value)
        return YaraConditionParse { value: matched, position: expected.position, valid: true, witness_name: "", witness_offset: -1 }
    }

    if ch == "$" {
        let mut end = i + 1
        while end < n and _yc_is_word_char(str_char_at(source, end)) {
            end = end + 1
        }
        if end == i + 1 {
            return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 }
        }
        let name = str_sub(source, i, end - i)
        let mut found = -1
        let mut p = 0
        while p < len(pattern_names) {
            if pattern_names[p] == name { found = p }
            p = p + 1
        }
        if found < 0 {
            return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 }
        }
        let suffix = _yc_skip_space(source, end)
        if _yc_keyword_at(source, suffix, "at") or _yc_keyword_at(source, suffix, "in") {
            if found >= len(pattern_patterns) or str_starts_with(pattern_patterns[found], "regex:") {
                return YaraConditionParse { value: false, position: suffix, valid: false, witness_name: "", witness_offset: -1 }
            }
            if _yc_keyword_at(source, suffix, "at") {
                let offset = _yc_parse_number(source, suffix + 2)
                if not offset.valid { return YaraConditionParse { value: false, position: offset.position, valid: false, witness_name: "", witness_offset: -1 } }
                let witness_offset = _yc_pattern_find_in_range(pattern_patterns[found], target, offset.value, offset.value, target_buffer)
                let matched = target_size >= 0 and witness_offset >= 0
                let mut witness_name = ""
                if matched { witness_name = name }
                return YaraConditionParse { value: matched, position: offset.position, valid: true, witness_name: witness_name, witness_offset: witness_offset }
            }
            let open = _yc_skip_space(source, suffix + 2)
            if open >= n or str_char_at(source, open) != "(" {
                return YaraConditionParse { value: false, position: open, valid: false, witness_name: "", witness_offset: -1 }
            }
            let lower = _yc_parse_number(source, open + 1)
            if not lower.valid { return YaraConditionParse { value: false, position: lower.position, valid: false, witness_name: "", witness_offset: -1 } }
            let dots = _yc_skip_space(source, lower.position)
            if dots + 1 >= n or str_sub(source, dots, 2) != ".." {
                return YaraConditionParse { value: false, position: dots, valid: false, witness_name: "", witness_offset: -1 }
            }
            let upper = _yc_parse_number(source, dots + 2)
            if not upper.valid or upper.value < lower.value {
                return YaraConditionParse { value: false, position: upper.position, valid: false, witness_name: "", witness_offset: -1 }
            }
            let close = _yc_skip_space(source, upper.position)
            if close >= n or str_char_at(source, close) != ")" {
                return YaraConditionParse { value: false, position: close, valid: false, witness_name: "", witness_offset: -1 }
            }
            let witness_offset = _yc_pattern_find_in_range(pattern_patterns[found], target, lower.value, upper.value, target_buffer)
            let matched = target_size >= 0 and witness_offset >= 0
            let mut witness_name = ""
            if matched { witness_name = name }
            return YaraConditionParse { value: matched, position: close + 1, valid: true, witness_name: witness_name, witness_offset: witness_offset }
        }
        let mut matched = false
        if found < len(pattern_values) { matched = pattern_values[found] }
        return YaraConditionParse { value: matched, position: end, valid: true, witness_name: "", witness_offset: -1 }
    }

    if ch == "#" {
        let mut end = i + 1
        while end < n and _yc_is_word_char(str_char_at(source, end)) { end = end + 1 }
        if end == i + 1 { return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 } }
        let name = "$" + str_sub(source, i + 1, end - i - 1)
        let mut found = -1
        let mut p = 0
        while p < len(pattern_names) {
            if pattern_names[p] == name { found = p }
            p = p + 1
        }
        if found < 0 { return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 } }
        let op_start = _yc_skip_space(source, end)
        let mut op = ""
        let mut op_len = 0
        if op_start + 1 < n {
            let pair = str_sub(source, op_start, 2)
            if pair == "<=" or pair == ">=" or pair == "==" or pair == "!=" {
                op = pair
                op_len = 2
            }
        }
        if op_len == 0 and op_start < n {
            let single = str_char_at(source, op_start)
            if single == "<" or single == ">" {
                op = single
                op_len = 1
            }
        }
        if op_len == 0 { return YaraConditionParse { value: false, position: op_start, valid: false, witness_name: "", witness_offset: -1 } }
        let number_start = _yc_skip_space(source, op_start + op_len)
        let expected_number = _yc_parse_number(source, number_start)
        if not expected_number.valid { return YaraConditionParse { value: false, position: expected_number.position, valid: false, witness_name: "", witness_offset: -1 } }
        let number_end = expected_number.position
        let expected = expected_number.value
        let mut count = 0
        if found < len(pattern_counts) { count = pattern_counts[found] }
        let mut matched = false
        if op == "<" { matched = count < expected }
        else if op == "<=" { matched = count <= expected }
        else if op == ">" { matched = count > expected }
        else if op == ">=" { matched = count >= expected }
        else if op == "==" { matched = count == expected }
        else if op == "!=" { matched = count != expected }
        return YaraConditionParse { value: matched, position: number_end, valid: true, witness_name: "", witness_offset: -1 }
    }

    if _yc_keyword_at(source, i, "true") {
        return YaraConditionParse { value: true, position: i + 4, valid: true, witness_name: "", witness_offset: -1 }
    }
    if _yc_keyword_at(source, i, "false") {
        return YaraConditionParse { value: false, position: i + 5, valid: true, witness_name: "", witness_offset: -1 }
    }
    if _yc_keyword_at(source, i, "filesize") {
        let op_start = _yc_skip_space(source, i + len("filesize"))
        let mut op = ""
        let mut op_len = 0
        if op_start + 1 < n {
            let pair = str_sub(source, op_start, 2)
            if pair == "<=" or pair == ">=" or pair == "==" or pair == "!=" {
                op = pair
                op_len = 2
            }
        }
        if op_len == 0 and op_start < n {
            let single = str_char_at(source, op_start)
            if single == "<" or single == ">" {
                op = single
                op_len = 1
            }
        }
        if op_len == 0 {
            return YaraConditionParse { value: false, position: op_start, valid: false, witness_name: "", witness_offset: -1 }
        }
        let number_start = _yc_skip_space(source, op_start + op_len)
        let limit_number = _yc_parse_number(source, number_start)
        if not limit_number.valid {
            return YaraConditionParse { value: false, position: limit_number.position, valid: false, witness_name: "", witness_offset: -1 }
        }
        let end = limit_number.position
        let limit = limit_number.value
        let mut matched = false
        if op == "<" { matched = target_size >= 0 and target_size < limit }
        else if op == "<=" { matched = target_size >= 0 and target_size <= limit }
        else if op == ">" { matched = target_size > limit }
        else if op == ">=" { matched = target_size >= limit }
        else if op == "==" { matched = target_size == limit }
        else if op == "!=" { matched = target_size >= 0 and target_size != limit }
        return YaraConditionParse { value: matched, position: end, valid: true, witness_name: "", witness_offset: -1 }
    }
    return YaraConditionParse { value: false, position: i, valid: false, witness_name: "", witness_offset: -1 }
}

fn _yc_parse_unary(source: str, position: int, pattern_names: str[], pattern_values: bool[], pattern_counts: int[], pattern_patterns: str[], target: str, target_size: int, target_buffer: int) -> YaraConditionParse {
    let i = _yc_skip_space(source, position)
    if _yc_keyword_at(source, i, "not") {
        let inner = _yc_parse_unary(source, i + 3, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size, target_buffer)
        if not inner.valid { return inner }
        return YaraConditionParse { value: not inner.value, position: inner.position, valid: true, witness_name: "", witness_offset: -1 }
    }
    return _yc_parse_primary(source, i, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size, target_buffer)
}

fn _yc_parse_and(source: str, position: int, pattern_names: str[], pattern_values: bool[], pattern_counts: int[], pattern_patterns: str[], target: str, target_size: int, target_buffer: int) -> YaraConditionParse {
    let mut left = _yc_parse_unary(source, position, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size, target_buffer)
    if not left.valid { return left }
    let mut next = _yc_skip_space(source, left.position)
    while _yc_keyword_at(source, next, "and") {
        let right = _yc_parse_unary(source, next + 3, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size, target_buffer)
        if not right.valid { return right }
        let combined_value = left.value and right.value
        let mut witness_name = left.witness_name
        let mut witness_offset = left.witness_offset
        if witness_offset < 0 and right.witness_offset >= 0 {
            witness_name = right.witness_name
            witness_offset = right.witness_offset
        }
        left = YaraConditionParse { value: combined_value, position: right.position, valid: true, witness_name: witness_name, witness_offset: witness_offset }
        next = _yc_skip_space(source, left.position)
    }
    return left
}

fn _yc_parse_or(source: str, position: int, pattern_names: str[], pattern_values: bool[], pattern_counts: int[], pattern_patterns: str[], target: str, target_size: int, target_buffer: int) -> YaraConditionParse {
    let mut left = _yc_parse_and(source, position, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size, target_buffer)
    if not left.valid { return left }
    let mut next = _yc_skip_space(source, left.position)
    while _yc_keyword_at(source, next, "or") {
        let right = _yc_parse_and(source, next + 2, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size, target_buffer)
        if not right.valid { return right }
        let combined_value = left.value or right.value
        let mut witness_name = left.witness_name
        let mut witness_offset = left.witness_offset
        if not left.value or witness_offset < 0 {
            if right.value and right.witness_offset >= 0 {
                witness_name = right.witness_name
                witness_offset = right.witness_offset
            }
        }
        left = YaraConditionParse { value: combined_value, position: right.position, valid: true, witness_name: witness_name, witness_offset: witness_offset }
        next = _yc_skip_space(source, left.position)
    }
    return left
}

fn yara_condition_validate(condition: str, pattern_names: str[], pattern_patterns: str[]) -> str {
    let empty_values: bool[] = []
    let empty_counts: int[] = []
    let parsed = _yc_parse_or(condition, 0, pattern_names, empty_values, empty_counts, pattern_patterns, "", -1, 0)
    if not parsed.valid {
        return "gecersiz veya desteklenmeyen condition ifadesi (byte " + int_to_str(parsed.position) + ")"
    }
    let end = _yc_skip_space(condition, parsed.position)
    if end != str_byte_len(condition) {
        return "condition ifadesinde beklenmeyen token (byte " + int_to_str(end) + ")"
    }
    return ""
}

fn _yc_evaluate_with_target_buffer(condition: str, pattern_names: str[], pattern_values: bool[], pattern_counts: int[], pattern_patterns: str[], target: str, target_size: int, target_buffer: int) -> YaraConditionParse {
    let parsed = _yc_parse_or(condition, 0, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size, target_buffer)
    if not parsed.valid { return parsed }
    if _yc_skip_space(condition, parsed.position) != str_byte_len(condition) {
        return YaraConditionParse { value: false, position: _yc_skip_space(condition, parsed.position), valid: false, witness_name: "", witness_offset: -1 }
    }
    return parsed
}

fn yara_condition_evaluate(condition: str, pattern_names: str[], pattern_values: bool[], pattern_counts: int[], pattern_patterns: str[], target: str, target_size: int) -> YaraConditionParse {
    return _yc_evaluate_with_target_buffer(condition, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size, 0)
}

fn yara_condition_evaluate_buffer(condition: str, pattern_names: str[], pattern_values: bool[], pattern_counts: int[], pattern_patterns: str[], target_buffer: int, target_size: int) -> YaraConditionParse {
    if target_buffer <= 0 {
        return YaraConditionParse { value: false, position: 0, valid: false, witness_name: "", witness_offset: -1 }
    }
    return _yc_evaluate_with_target_buffer(condition, pattern_names, pattern_values, pattern_counts, pattern_patterns, "", target_size, target_buffer)
}

fn yara_condition_matches(condition: str, pattern_names: str[], pattern_values: bool[], pattern_counts: int[], pattern_patterns: str[], target: str, target_size: int) -> bool {
    return yara_condition_evaluate(condition, pattern_names, pattern_values, pattern_counts, pattern_patterns, target, target_size).value
}
