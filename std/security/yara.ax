// Axiom Standard Library - Enterprise YARA Signature & Bytecode Scanner (std:security:yara)
// std/security/yara.ax
//
// Özellikler:
// - Hex wildcard maskeli bayt taraması (örn. "48 89 ?? 55 ?? 8b", "E8 ?? ?? ?? ??")
// - Boyer-Moore-Horspool / Sunday Quick-Search bayt arama motoru
// - Bayt kaydırma ve ofset kısıtlamaları (min_offset, max_offset, exact offset)
// - YARA koşul alt kümesi: desen grupları, boolean ifadeler ve filesize
// - YaraRule, YaraMatch, YaraRuleSet veri yapıları

import "std:text:regex"
import "std:encoding:hex"
import "std/security/yara_condition"

// -----------------------------------------------------------------------------
// Veri Yapıları (YARA Core Data Structures)
// -----------------------------------------------------------------------------

/// Bir desen eslesmesinin sonucu.
///
/// `offset` eslesmenin bayt konumu, `matched_len` uzunlugu;
/// eslesme yoksa `matched = false` ve `offset = -1`.
struct YaraMatch {
    rule_name: str,
    pattern_id: str,
    offset: int,
    matched_len: int,
    matched: bool
}

/// Tek bir YARA kurali: desenler, kosul ve ofset sinirlari.
struct YaraRule {
    name: str,
    tags: str[],
    meta_keys: str[],
    meta_values: str[],
    meta_types: str[],
    patterns: str[],
    pattern_names: str[],
    condition: str,
    min_offset: int,
    max_offset: int
}

/// Birden cok `YaraRule` barindiran kural seti.
struct YaraRuleSet {
    rules: YaraRule[]
}

// -----------------------------------------------------------------------------
// Kural ve Kural Seti Oluşturucuları (Rule & RuleSet Builders)
// -----------------------------------------------------------------------------

/// Yeni bir kural olusturur.
///
/// `condition`: `"any of them"`, `"all of them"`, `"N of them"` veya
/// desteklenen YARA boolean koşullarından biri.
fn yara_rule_new(name: str, condition: str) -> YaraRule {
    let p: str[] = [];
    let pn: str[] = [];
    let tags: str[] = [];
    let meta_keys: str[] = [];
    let meta_values: str[] = [];
    let meta_types: str[] = [];
    return YaraRule {
        name: name,
        tags: tags,
        meta_keys: meta_keys,
        meta_values: meta_values,
        meta_types: meta_types,
        patterns: p,
        pattern_names: pn,
        condition: condition,
        min_offset: -1,
        max_offset: -1
    };
}

/// Kurala bir desen ekler.
///
/// `pattern_id` (`"$a"`) ve `pattern_str` (`"str:..."`, `"hex:..."`,
/// `"regex:..."`) birlikte saklanir.
fn yara_rule_add_pattern(rule: YaraRule, pattern_id: str, pattern_str: str) -> YaraRule {
    let p = array_push(rule.patterns, pattern_str);
    let pn = array_push(rule.pattern_names, pattern_id);
    return YaraRule {
        name: rule.name,
        tags: rule.tags,
        meta_keys: rule.meta_keys,
        meta_values: rule.meta_values,
        meta_types: rule.meta_types,
        patterns: p,
        pattern_names: pn,
        condition: rule.condition,
        min_offset: rule.min_offset,
        max_offset: rule.max_offset
    };
}

fn yara_rule_add_tag(rule: YaraRule, tag: str) -> YaraRule {
    let tags = array_push(rule.tags, tag)
    return YaraRule {
        name: rule.name,
        tags: tags,
        meta_keys: rule.meta_keys,
        meta_values: rule.meta_values,
        meta_types: rule.meta_types,
        patterns: rule.patterns,
        pattern_names: rule.pattern_names,
        condition: rule.condition,
        min_offset: rule.min_offset,
        max_offset: rule.max_offset
    }
}

fn yara_rule_add_meta(rule: YaraRule, key: str, value: str, value_type: str) -> YaraRule {
    let keys = array_push(rule.meta_keys, key)
    let values = array_push(rule.meta_values, value)
    let types = array_push(rule.meta_types, value_type)
    return YaraRule {
        name: rule.name,
        tags: rule.tags,
        meta_keys: keys,
        meta_values: values,
        meta_types: types,
        patterns: rule.patterns,
        pattern_names: rule.pattern_names,
        condition: rule.condition,
        min_offset: rule.min_offset,
        max_offset: rule.max_offset
    }
}

/// Eslesmenin aranacagi ofset araligini sinirlar (dahil).
fn yara_rule_set_offset_bounds(rule: YaraRule, min_offset: int, max_offset: int) -> YaraRule {
    return YaraRule {
        name: rule.name,
        tags: rule.tags,
        meta_keys: rule.meta_keys,
        meta_values: rule.meta_values,
        meta_types: rule.meta_types,
        patterns: rule.patterns,
        pattern_names: rule.pattern_names,
        condition: rule.condition,
        min_offset: min_offset,
        max_offset: max_offset
    };
}

/// Eslesmeyi tek bir kesin ofsete sabitler.
fn yara_rule_set_at_offset(rule: YaraRule, offset: int) -> YaraRule {
    return YaraRule {
        name: rule.name,
        tags: rule.tags,
        meta_keys: rule.meta_keys,
        meta_values: rule.meta_values,
        meta_types: rule.meta_types,
        patterns: rule.patterns,
        pattern_names: rule.pattern_names,
        condition: rule.condition,
        min_offset: offset,
        max_offset: offset
    };
}

/// Bos bir kural seti olusturur.
fn yara_ruleset_new() -> YaraRuleSet {
    let r: YaraRule[] = [];
    return YaraRuleSet { rules: r };
}

/// Kural setine kural ekler (yeni set dondurur).
fn yara_ruleset_add_rule(ruleset: YaraRuleSet, rule: YaraRule) -> YaraRuleSet {
    let r = array_push(ruleset.rules, rule);
    return YaraRuleSet { rules: r };
}

// -----------------------------------------------------------------------------
// Düşük Seviye Hex & Bayt Tarama Fonksiyonları
// -----------------------------------------------------------------------------

fn yara_find_hex_wildcard(target: str, hex_pattern: str) -> int {
    let off = rt_yara_find_hex_wildcard(target, hex_pattern, -1, -1);
    if (off >= 0) {
        return off;
    }
    return rt_yara_find_hex_stream(target, hex_pattern);
}

fn yara_find_hex_wildcard_at(target: str, hex_pattern: str, min_offset: int, max_offset: int) -> int {
    let off = rt_yara_find_hex_wildcard(target, hex_pattern, min_offset, max_offset);
    if (off >= 0) {
        return off;
    }
    let hex_off = rt_yara_find_hex_stream(target, hex_pattern);
    if (hex_off >= 0) {
        if (min_offset >= 0 and hex_off < min_offset) { return -1; }
        if (max_offset >= 0 and hex_off > max_offset) { return -1; }
        return hex_off;
    }
    return -1;
}

fn yara_match_hex_wildcard(target: str, hex_pattern: str) -> bool {
    let off = yara_find_hex_wildcard(target, hex_pattern);
    return off >= 0;
}

fn yara_find_hex_stream(hex_target: str, hex_pattern: str) -> int {
    return rt_yara_find_hex_stream(hex_target, hex_pattern);
}

fn yara_scan_hex_stream(hex_target: str, hex_pattern: str) -> bool {
    let off = rt_yara_find_hex_stream(hex_target, hex_pattern);
    return off >= 0;
}

fn yara_scan_buf(buf_handle: int, hex_pattern: str, min_offset: int, max_offset: int) -> int {
    return rt_yara_scan_buf_handle(buf_handle, hex_pattern, min_offset, max_offset);
}

// The text runtime supports nocase (1), ascii (2), and fullword (8).
// Reject unknown flag bits, including wide, instead of silently using ASCII.
fn _yara_text_flags_supported(flags: int) -> bool {
    return flags == 0 or flags == 1 or flags == 2 or flags == 3
        or flags == 8 or flags == 9 or flags == 10 or flags == 11
}

fn _yara_text_flags_parse(raw: str) -> int {
    if raw == "0" { return 0 }
    if raw == "1" { return 1 }
    if raw == "2" { return 2 }
    if raw == "3" { return 3 }
    if raw == "8" { return 8 }
    if raw == "9" { return 9 }
    if raw == "10" { return 10 }
    if raw == "11" { return 11 }
    return -1
}

/// Regex'i guvenlik kapisindan gecirerek tarar; gecersiz veya riskli desen Err verir.
/// Regex kullanan cagiranlar hata bilgisini korumak icin bu API'yi tercih etmelidir.
fn yara_scan_regex_result(buf: str, regex_pattern: str) -> Result < bool, str > {
    return regex_is_match_result(regex_pattern, buf)
}

/// Pattern'in regex kismi varsa gecerli ve guvenli oldugunu dogrular.
/// Gecerliyse bos metin, aksi halde hata mesaji dondurur.
fn yara_validate_pattern(pattern_str: str) -> str {
    if str_starts_with(pattern_str, "regex:") {
        let p = str_sub(pattern_str, 6, str_len(pattern_str) - 6)
        return regex_validate(p)
    }
    return ""
}

// -----------------------------------------------------------------------------
// Tekli Desen ve Kural Eşleme Mantığı (Pattern & Rule Scanning Engine)
// -----------------------------------------------------------------------------

/// Tek bir deseni hedefte tarar.
///
/// `min_offset`/`max_offset` `-1` ise sinir yoktur.
/// Desen turleri: `str:`, `hex:` (wildcard/jump/alternation/negation), `regex:`.
fn yara_scan_single_pattern(target: str, pattern_id: str, pattern_str: str, min_offset: int, max_offset: int) -> YaraMatch {
    // 1. Regex Deseni
    if (str_starts_with(pattern_str, "regex:")) {
        let p = str_sub(pattern_str, 6, str_len(pattern_str) - 6);
        // Eski YARA runtime cagrisi regex_validate kapisini atliyordu.
        // regex_is_match_result once guvenlik/sozdizimi kontrolu yapar.
        let result = yara_scan_regex_result(target, p);
        let ok = result.is_ok and result.value;
        if (ok) {
            return YaraMatch {
                rule_name: "",
                pattern_id: pattern_id,
                offset: 0,
                matched_len: 0,
                matched: true
            };
        }
        return YaraMatch {
            rule_name: "",
            pattern_id: pattern_id,
            offset: -1,
            matched_len: 0,
            matched: false
        };
    }

    // All supported hex forms share one occurrence matcher. This keeps
    // bounded jumps, alternation, negation and fixed bytes on the same path.
    if str_starts_with(pattern_str, "hexast:v1:") or str_starts_with(pattern_str, "hex:") or str_starts_with(pattern_str, "hexrange:") or str_starts_with(pattern_str, "hexalt:") or str_starts_with(pattern_str, "hexnot:") {
        let off = rt_yara_find_hex_pattern(target, pattern_str, min_offset, max_offset)
        if off >= 0 {
            let match_len = rt_yara_hex_pattern_length_at(target, pattern_str, off)
            if match_len > 0 {
                return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: off, matched_len: match_len, matched: true }
            }
        }
        return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false }
    }

    // 2. Açık metin deseni. Modifier'lar flags prefix'iyle kodlanır.
    if (str_starts_with(pattern_str, "str:")) {
        let nocase = str_starts_with(pattern_str, "str:nocase:");
        let flagged = str_starts_with(pattern_str, "str:flags:");
        let mut p = str_sub(pattern_str, 4, str_len(pattern_str) - 4);
        let mut flags = 0;
        if nocase {
            p = str_sub(pattern_str, len("str:nocase:"), str_len(pattern_str) - len("str:nocase:"));
        }
        if flagged {
            let rest = str_sub(pattern_str, len("str:flags:"), str_len(pattern_str) - len("str:flags:"));
            let sep = str_index_of(rest, ":");
            if sep < 0 {
                return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false };
            }
            flags = _yara_text_flags_parse(str_sub(rest, 0, sep));
            p = str_sub(rest, sep + 1, str_len(rest) - sep - 1);
        }
        if flags < 0 or not _yara_text_flags_supported(flags) {
            return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false };
        }
        let mut idx = -1;
        let mut match_len = str_byte_len(p);
        if nocase { flags = 1 }
        idx = rt_yara_find_text(target, p, flags, min_offset, max_offset);
        if (idx >= 0) {
            if (min_offset >= 0 and idx < min_offset) {
                return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false };
            }
            if (max_offset >= 0 and idx > max_offset) {
                return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false };
            }
            return YaraMatch {
                rule_name: "",
                pattern_id: pattern_id,
                offset: idx,
                matched_len: match_len,
                matched: true
            };
        }
        return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false };
    }

    // 3. Hex Wildcard Deseni (hex:... veya ?? veya boşluklu hex baytları içerenler)
    let is_hex_explicit = str_starts_with(pattern_str, "hex:") or str_starts_with(pattern_str, "{");
    let has_wildcard = str_contains(pattern_str, "??") or str_contains(pattern_str, "?");
    let has_space = str_contains(pattern_str, " ");

    if (is_hex_explicit or has_wildcard or has_space) {
        let mut clean_p = pattern_str;
        if (str_starts_with(clean_p, "hex:")) {
            clean_p = str_sub(clean_p, 4, str_len(clean_p) - 4);
        }
        let mut off = rt_yara_find_hex_wildcard(target, clean_p, min_offset, max_offset);
        if (off < 0) {
            let stream_off = rt_yara_find_hex_stream(target, clean_p);
            if (stream_off >= 0) {
                let mut valid = true;
                if (min_offset >= 0 and stream_off < min_offset) { valid = false; }
                if (max_offset >= 0 and stream_off > max_offset) { valid = false; }
                if (valid) { off = stream_off; }
            }
        }
        if (off >= 0) {
            let mlen = rt_yara_pattern_len(clean_p);
            return YaraMatch {
                rule_name: "",
                pattern_id: pattern_id,
                offset: off,
                matched_len: mlen,
                matched: true
            };
        }
        return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false };
    }

    // 4. Varsayılan Metin ve Hex Fallback
    let sub_idx = str_index_of(target, pattern_str);
    if (sub_idx >= 0) {
        if (min_offset >= 0 and sub_idx < min_offset) {
            return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false };
        }
        if (max_offset >= 0 and sub_idx > max_offset) {
            return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false };
        }
        return YaraMatch {
            rule_name: "",
            pattern_id: pattern_id,
            offset: sub_idx,
            matched_len: str_len(pattern_str),
            matched: true
        };
    }

    // Düz hex bayt deseni olabilir mi?
    let mut fallback_off = rt_yara_find_hex_wildcard(target, pattern_str, min_offset, max_offset);
    if (fallback_off < 0) {
        let stream_off = rt_yara_find_hex_stream(target, pattern_str);
        if (stream_off >= 0) {
            let mut valid = true;
            if (min_offset >= 0 and stream_off < min_offset) { valid = false; }
            if (max_offset >= 0 and stream_off > max_offset) { valid = false; }
            if (valid) { fallback_off = stream_off; }
        }
    }
    if (fallback_off >= 0) {
        let mlen = rt_yara_pattern_len(pattern_str);
        return YaraMatch {
            rule_name: "",
            pattern_id: pattern_id,
            offset: fallback_off,
            matched_len: mlen,
            matched: true
        };
    }

    return YaraMatch { rule_name: "", pattern_id: pattern_id, offset: -1, matched_len: 0, matched: false };
}

// Counts text and hex-pattern hits in one runtime pass, including overlaps.
// Regex counts remain unsupported because the regex API exposes no instances.
fn yara_count_single_pattern(target: str, pattern_str: str) -> int {
    if str_starts_with(pattern_str, "regex:") { return -1 }
    if str_starts_with(pattern_str, "hexast:v1:") or str_starts_with(pattern_str, "hex:") or str_starts_with(pattern_str, "hexrange:") or str_starts_with(pattern_str, "hexalt:") or str_starts_with(pattern_str, "hexnot:") {
        return rt_yara_count_hex_pattern(target, pattern_str)
    }
    if str_starts_with(pattern_str, "str:") {
        let mut p = str_sub(pattern_str, 4, str_len(pattern_str) - 4)
        let mut flags = 0
        if str_starts_with(pattern_str, "str:nocase:") {
            p = str_sub(pattern_str, len("str:nocase:"), str_len(pattern_str) - len("str:nocase:"))
            flags = 1
        } else if str_starts_with(pattern_str, "str:flags:") {
            let rest = str_sub(pattern_str, len("str:flags:"), str_len(pattern_str) - len("str:flags:"))
            let sep = str_index_of(rest, ":")
            if sep < 0 { return -1 }
            flags = _yara_text_flags_parse(str_sub(rest, 0, sep))
            p = str_sub(rest, sep + 1, str_len(rest) - sep - 1)
        }
        if flags < 0 or not _yara_text_flags_supported(flags) { return -1 }
        return rt_yara_count_text(target, p, flags)
    }
    return -1
}

/// Kuralin tum desenlerini tarar ve kosulunu uygular.
fn yara_scan_rule(target: str, rule: YaraRule) -> YaraMatch {
    return yara_scan_rule_with_filesize(target, rule, str_byte_len(target))
}

fn yara_scan_rule_with_filesize(target: str, rule: YaraRule, target_size: int) -> YaraMatch {
    let total_patterns = len(rule.patterns);
    let cond = rule.condition;
    let mut matched_count = 0;
    let mut pattern_values: bool[] = [];
    let mut pattern_counts: int[] = [];
    let mut first_matched_pid = "";
    let mut first_offset = -1;
    let mut first_len = 0;

    let mut i = 0;
    while (i < total_patterns) {
        let pid = rule.pattern_names[i];
        let pstr = rule.patterns[i];
        let m = yara_scan_single_pattern(target, pid, pstr, rule.min_offset, rule.max_offset);
        pattern_values = array_push(pattern_values, m.matched);
        let mut occurrence_count = -1
        if str_contains(cond, "#") {
            occurrence_count = yara_count_single_pattern(target, pstr)
        }
        pattern_counts = array_push(pattern_counts, occurrence_count);
        if (m.matched) {
            matched_count = matched_count + 1;
            if (first_offset < 0) {
                first_offset = m.offset;
                first_matched_pid = pid;
                first_len = m.matched_len;
            }
        }
        i = i + 1;
    }

    // Koşul Mantığının Değerlendirilmesi (Condition Evaluation)
    let mut is_rule_matched = false;
    let mut condition_witness_name = "";
    let mut condition_witness_offset = -1;

    if cond == "all" {
        is_rule_matched = (matched_count == total_patterns);
    } else if cond == "any" {
        is_rule_matched = (matched_count > 0);
    } else {
        let condition_result = yara_condition_evaluate(cond, rule.pattern_names, pattern_values, pattern_counts, rule.patterns, target, target_size);
        is_rule_matched = condition_result.value;
        condition_witness_name = condition_result.witness_name;
        condition_witness_offset = condition_result.witness_offset;
    }

    // A positional condition may be satisfied by a later instance than the
    // first occurrence found by the ordinary pattern scan. Report that exact
    // occurrence as evidence instead of an unrelated earlier one.
    if is_rule_matched and condition_witness_offset >= 0 {
        let mut witness_index = 0;
        while witness_index < total_patterns {
            if rule.pattern_names[witness_index] == condition_witness_name {
                let witness = yara_scan_single_pattern(
                    target,
                    condition_witness_name,
                    rule.patterns[witness_index],
                    condition_witness_offset,
                    condition_witness_offset
                );
                if witness.matched {
                    first_matched_pid = witness.pattern_id;
                    first_offset = witness.offset;
                    first_len = witness.matched_len;
                }
                witness_index = total_patterns;
            } else {
                witness_index = witness_index + 1;
            }
        }
    }

    if (is_rule_matched) {
        return YaraMatch {
            rule_name: rule.name,
            pattern_id: first_matched_pid,
            offset: first_offset,
            matched_len: first_len,
            matched: true
        };
    }

    return YaraMatch {
        rule_name: rule.name,
        pattern_id: "",
        offset: -1,
        matched_len: 0,
        matched: false
    };
}

/// Kural hedefle eslesiyor mu? (kisa yol)
fn yara_rule_is_match(target: str, rule: YaraRule) -> bool {
    let m = yara_scan_rule(target, rule);
    return m.matched;
}

/// Kural setindeki tum eslesmeleri dondurur.
fn yara_ruleset_scan(target: str, ruleset: YaraRuleSet) -> YaraMatch[] {
    return yara_ruleset_scan_with_filesize(target, ruleset, str_byte_len(target))
}

fn yara_ruleset_scan_with_filesize(target: str, ruleset: YaraRuleSet, target_size: int) -> YaraMatch[] {
    let mut matches: YaraMatch[] = [];
    let num_rules = len(ruleset.rules);
    let mut i = 0;
    while (i < num_rules) {
        let m = yara_scan_rule_with_filesize(target, ruleset.rules[i], target_size);
        if (m.matched) {
            matches = array_push(matches, m);
        }
        i = i + 1;
    }
    return matches;
}

/// Kural setinde en az bir eslesme var mi?
fn yara_ruleset_has_match(target: str, ruleset: YaraRuleSet) -> bool {
    let matches = yara_ruleset_scan(target, ruleset);
    return len(matches) > 0;
}

/// Kural setindeki eslesen kural sayisi.
fn yara_ruleset_count_matches(target: str, ruleset: YaraRuleSet) -> int {
    let matches = yara_ruleset_scan(target, ruleset);
    return len(matches);
}

// -----------------------------------------------------------------------------
// Geriye Dönük Uyumluluk Fonksiyonları (Legacy Compatibility API)
// -----------------------------------------------------------------------------

/// Geriye donuk uyumluluk: hedefte anahtar sozcuk arar.
fn yara_scan_buffer(buf: str, keyword_pattern: str) -> bool
    requires len(buf) > 0
    requires len(keyword_pattern) > 0
{
    return str_contains(buf, keyword_pattern);
}

/// Geriye donuk uyumluluk: hedefte regex eslesmesi arar.
fn yara_scan_regex(buf: str, regex_pattern: str) -> bool
    requires len(buf) > 0
    requires len(regex_pattern) > 0
{
    let result = yara_scan_regex_result(buf, regex_pattern);
    return result.is_ok and result.value;
}

/// Geriye donuk uyumluluk: hex veride hex deseni arar.
fn yara_scan_hex(hex_data: str, hex_pattern: str) -> bool
    requires len(hex_data) > 0
    requires len(hex_pattern) > 0
{
    if (str_contains(hex_pattern, "?") or str_contains(hex_pattern, " ")) {
        let off = rt_yara_find_hex_stream(hex_data, hex_pattern);
        return off >= 0;
    }
    return str_contains(hex_data, hex_pattern);
}
