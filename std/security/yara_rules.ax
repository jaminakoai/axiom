// Axiom Standard Library: std/security/yara_rules
//
// YARA kural METNINI ayristirir ve `YaraRuleSet` uretir.
//
// v0.1 desteklenen alt kume:
//
//   rule Zararli_Ornek {
//       strings:
//           $a = "CreateRemoteThread"
//           $b = { 48 89 ?? 55 E8 ?? ?? ?? ?? }
//           $c = "powershell -enc"
//       condition:
//           any of them
//   }
//
// Kosullar: `any/all/none of them` ve `N of them` (N tamsayi).
//
// Desteklenmeyen YARA ozellikleri: meta/tags, birlesik condition ifadeleri,
// at/in, wide ve gelismis hex operatorleri.
// Desteklenmeyen ifadeler sessizce atlanmaz; ayrisim hatasi olarak reddedilir.

import "std/core/error"
import "std/text/unicode"
import "std/security/yara"
import "std/text/regex"
import "std/encoding/hex"
import "std/security/yara_condition"

// --- Yardimcilar ---

fn _trim_blank(s: str) -> str {
    return str_trim(s)
}

fn _is_blank(s: str) -> bool {
    return len(str_trim(s)) == 0
}

fn _starts_with_ci(s: str, prefix: str) -> bool {
    if len(s) < len(prefix) {
        return false
    }
    return to_lower_tr(str_sub(s, 0, len(prefix))) == to_lower_tr(prefix)
}

// "rule Ad {" satirindan adi cikarir. Ad yoksa "".
fn _parse_rule_name(line: str) -> str {
    let t = str_trim(line)
    if not _starts_with_ci(t, "rule") {
        return ""
    }
    let rest = str_trim(str_sub(t, 4, len(t) - 4))
    if len(rest) == 0 {
        return ""
    }
    // ilk bosluga veya '{' karakterine kadar
    let mut i = 0
    let mut name = ""
    while i < len(rest) {
        let ch = str_char_at(rest, i)
        if ch == " " or ch == "{" or ch == ":" {
            break
        }
        name = name + ch
        i = i + 1
    }
    // tag'leri atla: "rule ad : tag1 tag2 {"
    return name
}

fn _find_unescaped_quote(s: str) -> int {
    let mut escaped = false
    let mut i = 0
    while i < len(s) {
        let ch = str_char_at(s, i)
        if escaped {
            escaped = false
        } else if ch == "\\" {
            escaped = true
        } else if ch == "\"" {
            return i
        }
        i = i + 1
    }
    return -1
}

// Runtime str degerleri NUL ile sonlandigi icin \x00 guvenli sekilde temsil
// edilemez. Diger temel YARA kacislari burada dogrulanip cozulur.
fn _yara_escape_error(s: str) -> str {
    let mut i = 0
    while i < len(s) {
        if str_char_at(s, i) == "\\" {
            if i + 1 >= len(s) {
                return "ters bolu sonda; gecersiz YARA kacisi"
            }
            let esc = str_char_at(s, i + 1)
            if esc == "\\" or esc == "\"" or esc == "n" or esc == "r" or esc == "t" {
                i = i + 2
            } else if esc == "x" {
                if i + 3 >= len(s) {
                    return "\\x kacisi iki hex basamagi gerektirir"
                }
                let hi = str_char_at(s, i + 2)
                let lo = str_char_at(s, i + 3)
                if not str_contains("0123456789abcdefABCDEF", hi) or not str_contains("0123456789abcdefABCDEF", lo) {
                    return "\\x kacisi gecersiz hex basamagi iceriyor"
                }
                if to_lower_tr(hi + lo) == "00" {
                    return "\\x00 desteklenmiyor: tarayici metni NUL'da sonlandiriyor"
                }
                i = i + 4
            } else {
                return "desteklenmeyen YARA kacisi: \\" + esc
            }
        } else {
            i = i + 1
        }
    }
    return ""
}

fn _decode_yara_text(s: str) -> str {
    let mut out = ""
    let mut i = 0
    while i < len(s) {
        let ch = str_char_at(s, i)
        if ch != "\\" {
            out = out + ch
            i = i + 1
        } else {
            let esc = str_char_at(s, i + 1)
            if esc == "\\" or esc == "\"" {
                out = out + esc
                i = i + 2
            } else if esc == "n" {
                out = out + "\n"
                i = i + 2
            } else if esc == "r" {
                out = out + "\r"
                i = i + 2
            } else if esc == "t" {
                out = out + "\t"
                i = i + 2
            } else {
                out = out + hex_decode(str_sub(s, i + 2, 2))
                i = i + 4
            }
        }
    }
    return out
}

fn _parse_text_modifier_flags(tail: str) -> int {
    let mut flags = 0
    let mut token = ""
    let mut seen_nocase = false
    let mut seen_ascii = false
    let mut seen_fullword = false
    let mut i = 0
    while i <= len(tail) {
        let mut ch = " "
        if i < len(tail) { ch = str_char_at(tail, i) }
        if ch == " " or ch == "\t" or i == len(tail) {
            if len(token) > 0 {
                if token == "nocase" and not seen_nocase {
                    flags = flags + 1
                    seen_nocase = true
                } else if token == "ascii" and not seen_ascii {
                    flags = flags + 2
                    seen_ascii = true
                } else if token == "wide" {
                    // Hedef metin C/NUL-sonlandirmali; UTF-16LE veri taranamaz.
                    return -1
                } else if token == "fullword" and not seen_fullword {
                    flags = flags + 8
                    seen_fullword = true
                } else {
                    return -1
                }
                token = ""
            }
        } else {
            token = token + ch
        }
        i = i + 1
    }
    return flags
}

// strings: bolumundeki "$id = ..." satirini ayristirir.
// Donus: ilk '=' isaretinden bolunebilen "$id=pattern" veya bos metin.
// Dinamik dizi dondurmemek LLVM erken-donus temizligiyle ilgili bir backend
// hatasini tetiklemeyi onler.
fn _parse_string_def(line: str) -> str {
    let t = str_trim(line)
    if not str_starts_with(t, "$") {
        return ""
    }
    let eq = str_index_of(t, "=")
    if eq < 0 {
        return ""
    }
    let id = str_trim(str_sub(t, 0, eq))
    let mut raw = str_trim(str_sub(t, eq + 1, len(t) - eq - 1))
    if len(id) == 0 or len(raw) == 0 {
        return ""
    }

    // Metin: temel kacislar ve desteklenen modifier'lar.
    if str_starts_with(raw, "\"") {
        let close = _find_unescaped_quote(str_sub(raw, 1, len(raw) - 1))
        if close < 0 {
            return ""
        }
        let tail = str_trim(str_sub(raw, close + 2, len(raw) - close - 2))
        let flags = _parse_text_modifier_flags(tail)
        if flags < 0 {
            return ""
        }
        let text = str_sub(raw, 1, close)
        let escape_error = _yara_escape_error(text)
        if len(escape_error) > 0 {
            return ""
        }
        if flags == 2 {
            // YARA'da ascii varsayilandir; acik yazimi hizli varsayilan yolda tut.
            return id + "=str:" + _decode_yara_text(text)
        }
        if flags > 0 {
            return id + "=str:flags:" + int_to_str(flags) + ":" + _decode_yara_text(text)
        }
        return id + "=str:" + _decode_yara_text(text)
    }

    // Hex: { 48 89 ?? 55 }
    if str_starts_with(raw, "{") {
        let close = str_index_of(raw, "}")
        if close < 0 {
            return ""
        }
        let hex = str_trim(str_sub(raw, 1, close - 1))
        if len(hex) == 0 {
            return ""
        }
        if str_contains(hex, "[") or str_contains(hex, "]") or str_contains(hex, "(") or str_contains(hex, ")") or str_contains(hex, "|") or str_contains(hex, "~") {
            return ""
        }
        let tail = str_trim(str_sub(raw, close + 1, len(raw) - close - 1))
        if len(tail) > 0 {
            return ""
        }
        return id + "=hex:" + hex
    }

    // Regex: /.../  — v0.1: desen olarak kullan
    if str_starts_with(raw, "/") {
        let close = str_index_of(str_sub(raw, 1, len(raw) - 1), "/")
        if close < 0 {
            return ""
        }
        let tail = str_trim(str_sub(raw, close + 2, len(raw) - close - 2))
        if len(tail) > 0 {
            return ""
        }
        let regex = str_sub(raw, 1, close)
        if len(regex_validate(regex)) > 0 {
            return ""
        }
        return id + "=regex:" + regex
    }
    return ""
}

// condition: satirini tek satira indirger.
fn _parse_condition(line: str) -> str {
    let t = str_trim(line)
    if not _starts_with_ci(t, "condition") {
        return ""
    }
    let colon = str_index_of(t, ":")
    if colon < 0 {
        return ""
    }
    return str_trim(str_sub(t, colon + 1, len(t) - colon - 1))
}

// Bu parser yalnizca bu condition alt kumesini dogru degerlendirir.
// Diger ifadeler scanner tarafinda varsayilan `any` gibi ele alinmasin.
fn _supported_condition(condition: str) -> bool {
    if condition == "any" or condition == "all" or condition == "any of them" or condition == "all of them" or condition == "none of them" {
        return true
    }
    if not str_ends_with(condition, " of them") {
        return false
    }
    let number = str_trim(str_sub(condition, 0, len(condition) - len(" of them")))
    if len(number) == 0 { return false }
    let mut i = 0
    while i < len(number) {
        if not str_contains("0123456789", str_char_at(number, i)) { return false }
        i = i + 1
    }
    return true
}

// YARA'daki // yorumlarini string icinde kesme. # yorum imi degildir:
// kosulda #a, string'de #malware gibi kullanimi koru.
fn _strip_line_comment(line: str) -> str {
    let mut in_string = false
    let mut escaped = false
    let mut i = 0
    while i < len(line) {
        let ch = str_char_at(line, i)
        if escaped {
            escaped = false
        } else if in_string and ch == "\\" {
            escaped = true
        } else if ch == "\"" {
            in_string = not in_string
        } else if not in_string and ch == "/" and i + 1 < len(line) and str_char_at(line, i + 1) == "/" {
            return str_sub(line, 0, i)
        }
        i = i + 1
    }
    return line
}

// --- Ana ayristirici ---

fn parse_yara_rules(text: str) -> Result<YaraRuleSet, str> {
    if len(text) == 0 {
        return result_err_with<YaraRuleSet>("bos kural dosyasi", yara_ruleset_new())
    }

    let lines = str_split(text, "\n")
    let mut ruleset = yara_ruleset_new()

    let mut in_rule = false
    let mut in_strings = false
    let mut in_condition = false
    let mut rule_name = ""
    let mut condition = "any of them"
    let mut condition_seen = false
    let mut condition_line = 0
    let mut rule = yara_rule_new("", "any of them")
    let mut rule_count = 0

    let mut i = 0
    while i < len(lines) {
        let raw_line = lines[i]
        let line = _strip_line_comment(raw_line)

        let trimmed = str_trim(line)

        if not in_rule {
            if _starts_with_ci(trimmed, "rule") {
                if str_contains(trimmed, ":") {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": etiketler bu YARA alt kumesinde desteklenmiyor",
                        yara_ruleset_new())
                }
                let name = _parse_rule_name(trimmed)
                if len(name) == 0 {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": kural adi eksik",
                        yara_ruleset_new())
                }
                in_rule = true
                in_strings = false
                in_condition = false
                rule_name = name
                condition = "any of them"
                condition_seen = false
                condition_line = 0
                rule = yara_rule_new(name, "any of them")
                rule_count = rule_count + 1
            } else if not _is_blank(trimmed) {
                return result_err_with<YaraRuleSet>(
                    "satir " + int_to_str(i + 1) + ": desteklenmeyen ust-duzey YARA yapisi: " + trimmed,
                    yara_ruleset_new())
            }
            i = i + 1
            continue
        }

        // Kural icindeyiz
        if _starts_with_ci(trimmed, "strings") {
            in_strings = true
            in_condition = false
            i = i + 1
            continue
        }
        if _starts_with_ci(trimmed, "condition") {
            in_strings = false
            condition_seen = true
            condition_line = i + 1
            condition = ""
            let c = _parse_condition(trimmed)
            if len(c) > 0 {
                condition = c
                in_condition = false
            } else {
                // Deger alt satirda: bir sonraki bos olmayan satiri al.
                in_condition = true
            }
            i = i + 1
            continue
        }

        if in_condition {
            if not _is_blank(trimmed) {
                condition = trimmed
                in_condition = false
            }
            i = i + 1
            continue
        }

        // Kapanis: yalnizca '}' iceren satir
        let t = trimmed
        if t == "}" {
            if len(rule_name) == 0 {
                return result_err_with<YaraRuleSet>(
                    "satir " + int_to_str(i + 1) + ": kural adi bos",
                    yara_ruleset_new())
            }
            if not condition_seen {
                return result_err_with<YaraRuleSet>(
                    "satir " + int_to_str(i + 1) + ": condition bolumu eksik",
                    yara_ruleset_new())
            }
            if not _supported_condition(condition) {
                let condition_error = yara_condition_validate(condition, rule.pattern_names)
                if len(condition_error) > 0 {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(condition_line) + ": " + condition_error,
                        yara_ruleset_new())
                }
            }
            if str_contains(condition, "#") {
                let mut pattern_index = 0
                while pattern_index < len(rule.patterns) {
                    if str_starts_with(rule.patterns[pattern_index], "regex:") or str_starts_with(rule.patterns[pattern_index], "hex:") {
                        return result_err_with<YaraRuleSet>(
                            "satir " + int_to_str(condition_line) + ": # desen sayimi yalniz metin desenlerinde destekleniyor",
                            yara_ruleset_new())
                    }
                    pattern_index = pattern_index + 1
                }
            }
            // Toplanan pattern'lari KORU, yalnizca kosulu guncelle.
            let final_rule = YaraRule {
                name: rule_name,
                patterns: rule.patterns,
                pattern_names: rule.pattern_names,
                condition: condition,
                min_offset: rule.min_offset,
                max_offset: rule.max_offset
            }
            ruleset = yara_ruleset_add_rule(ruleset, final_rule)
            in_rule = false
            in_strings = false
            in_condition = false
            i = i + 1
            continue
        }

        if condition_seen {
            if not _is_blank(trimmed) {
                return result_err_with<YaraRuleSet>(
                    "satir " + int_to_str(i + 1) + ": cok satirli veya ek condition ifadesi desteklenmiyor",
                    yara_ruleset_new())
            }
            i = i + 1
            continue
        }

        if in_strings {
            let parsed = _parse_string_def(trimmed)
            if not _is_blank(trimmed) {
                if not str_starts_with(trimmed, "$") {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": desteklenmeyen strings girdisi",
                        yara_ruleset_new())
                }
                if len(parsed) == 0 {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": hatali veya desteklenmeyen string tanimi",
                        yara_ruleset_new())
                }
                let sep = str_index_of(parsed, "=")
                if sep < 0 {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": hatali string tanimi",
                        yara_ruleset_new())
                }
                rule = yara_rule_add_pattern(rule,
                    str_sub(parsed, 0, sep),
                    str_sub(parsed, sep + 1, len(parsed) - sep - 1))
            }
        } else if not _is_blank(trimmed) and not str_starts_with(trimmed, "{") {
            return result_err_with<YaraRuleSet>(
                "satir " + int_to_str(i + 1) + ": desteklenmeyen kural yapisi: " + trimmed,
                yara_ruleset_new())
        }

        i = i + 1
    }

    if in_rule {
        return result_err_with<YaraRuleSet>(
            "kural kapatilmadi (eksik '}'): " + rule_name, yara_ruleset_new())
    }
    if rule_count == 0 {
        return result_err_with<YaraRuleSet>("hic kural bulunamadi", yara_ruleset_new())
    }
    return result_ok<YaraRuleSet>(ruleset)
}
