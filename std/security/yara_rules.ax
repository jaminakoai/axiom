// Axiom Standard Library: std/security/yara_rules
//
// YARA kural METNINI ayristirir ve `YaraRuleSet` uretir.
//
// v0.1 desteklenen alt kume:
//
//   rule Zararli_Ornek {
//       strings:
//           $a = "CreateRemoteThread"
//           $b = { 48 89 ?? 55 E8 ?? ?? ?? ?? }
//           $c = "powershell -enc"
//       condition:
//           any of them
//   }
//
// Kosullar: desen basvurulari/gruplari, `at`/`in`, `#`/`@`/`!`, filesize,
// boolean operatorleri ve parantezler. meta ve rule tag'leri de ayrisip
// rapora tasinir. Metin desenlerinde nocase/ascii/fullword desteklenir.
//
// Desteklenmeyen YARA ozellikleri (wide, xor/base64 ve gelismis hex yapilari
// gibi) sessizce atlanmaz; ayrisim hatasi olarak reddedilir.

import "std/core/error"
import "std/text/unicode"
import "std/security/yara"
import "std/text/regex"
import "std/encoding/hex"
import "std/security/yara_condition"

struct YaraMetaParse {
    key: str,
    stored_value: str,
    value_type: str,
    valid: bool
}

// --- Yardimcilar ---

fn _trim_blank(s: str) -> str {
    return str_trim(s)
}

fn _is_blank(s: str) -> bool {
    return len(str_trim(s)) == 0
}

fn _starts_with_ci(s: str, prefix: str) -> bool {
    if len(s) < len(prefix) {
        return false
    }
    return to_lower_tr(str_sub(s, 0, len(prefix))) == to_lower_tr(prefix)
}

// "rule Ad {" satirindan adi cikarir. Ad yoksa "".
fn _parse_rule_name(line: str) -> str {
    let t = str_trim(line)
    if not _starts_with_ci(t, "rule") {
        return ""
    }
    let rest = str_trim(str_sub(t, 4, len(t) - 4))
    if len(rest) == 0 {
        return ""
    }
    // ilk bosluga veya '{' karakterine kadar
    let mut i = 0
    let mut name = ""
    while i < len(rest) {
        let ch = str_char_at(rest, i)
        if ch == " " or ch == "{" or ch == ":" {
            break
        }
        name = name + ch
        i = i + 1
    }
    // tag'leri atla: "rule ad : tag1 tag2 {"
    return name
}

fn _find_unescaped_quote(s: str) -> int {
    let mut escaped = false
    let mut i = 0
    while i < len(s) {
        let ch = str_char_at(s, i)
        if escaped {
            escaped = false
        } else if ch == "\\" {
            escaped = true
        } else if ch == "\"" {
            return i
        }
        i = i + 1
    }
    return -1
}

// Runtime str degerleri NUL ile sonlandigi icin \x00 guvenli sekilde temsil
// edilemez. Diger temel YARA kacislari burada dogrulanip cozulur.
fn _yara_escape_error(s: str) -> str {
    let mut i = 0
    while i < len(s) {
        if str_char_at(s, i) == "\\" {
            if i + 1 >= len(s) {
                return "ters bolu sonda; gecersiz YARA kacisi"
            }
            let esc = str_char_at(s, i + 1)
            if esc == "\\" or esc == "\"" or esc == "n" or esc == "r" or esc == "t" {
                i = i + 2
            } else if esc == "x" {
                if i + 3 >= len(s) {
                    return "\\x kacisi iki hex basamagi gerektirir"
                }
                let hi = str_char_at(s, i + 2)
                let lo = str_char_at(s, i + 3)
                if not str_contains("0123456789abcdefABCDEF", hi) or not str_contains("0123456789abcdefABCDEF", lo) {
                    return "\\x kacisi gecersiz hex basamagi iceriyor"
                }
                if to_lower_tr(hi + lo) == "00" {
                    return "\\x00 desteklenmiyor: tarayici metni NUL'da sonlandiriyor"
                }
                i = i + 4
            } else {
                return "desteklenmeyen YARA kacisi: \\" + esc
            }
        } else {
            i = i + 1
        }
    }
    return ""
}

fn _decode_yara_text(s: str) -> str {
    let mut out = ""
    let mut i = 0
    while i < len(s) {
        let ch = str_char_at(s, i)
        if ch != "\\" {
            out = out + ch
            i = i + 1
        } else {
            let esc = str_char_at(s, i + 1)
            if esc == "\\" or esc == "\"" {
                out = out + esc
                i = i + 2
            } else if esc == "n" {
                out = out + "\n"
                i = i + 2
            } else if esc == "r" {
                out = out + "\r"
                i = i + 2
            } else if esc == "t" {
                out = out + "\t"
                i = i + 2
            } else {
                out = out + hex_decode(str_sub(s, i + 2, 2))
                i = i + 4
            }
        }
    }
    return out
}

fn _parse_text_modifier_flags(tail: str) -> int {
    let mut flags = 0
    let mut token = ""
    let mut seen_nocase = false
    let mut seen_ascii = false
    let mut seen_fullword = false
    let mut i = 0
    while i <= len(tail) {
        let mut ch = " "
        if i < len(tail) { ch = str_char_at(tail, i) }
        if ch == " " or ch == "\t" or i == len(tail) {
            if len(token) > 0 {
                if token == "nocase" and not seen_nocase {
                    flags = flags + 1
                    seen_nocase = true
                } else if token == "ascii" and not seen_ascii {
                    flags = flags + 2
                    seen_ascii = true
                } else if token == "wide" {
                    // Hedef metin C/NUL-sonlandirmali; UTF-16LE veri taranamaz.
                    return -1
                } else if token == "fullword" and not seen_fullword {
                    flags = flags + 8
                    seen_fullword = true
                } else {
                    return -1
                }
                token = ""
            }
        } else {
            token = token + ch
        }
        i = i + 1
    }
    return flags
}

fn _is_hex_pattern_digit(ch: str) -> bool {
    return str_contains("0123456789abcdefABCDEF", ch)
}

struct YaraJumpEndpoint {
    value: int,
    position: int,
    valid: bool
}

struct YaraHexAlternation {
    branches: str,
    position: int,
    byte_length: int,
    has_constrained_byte: bool,
    valid: bool
}

fn _parse_yara_jump_endpoint(source: str, position: int) -> YaraJumpEndpoint {
    let mut cursor = position
    let mut value = 0
    let mut digits = 0
    while cursor < len(source) and str_contains("0123456789", str_char_at(source, cursor)) {
        if digits >= 2 { return YaraJumpEndpoint { value: 0, position: cursor, valid: false } }
        value = value * 10 + str_to_int(str_char_at(source, cursor))
        digits = digits + 1
        cursor = cursor + 1
    }
    return YaraJumpEndpoint { value: value, position: cursor, valid: digits > 0 }
}

// Parse one flat alternation with 2-4 equal-length byte branches. Branches
// contain only complete/nibble-wildcard byte tokens; nested syntax is rejected.
fn _parse_yara_hex_alternation(source: str, position: int) -> YaraHexAlternation {
    let mut cursor = position + 1
    let mut branches = ""
    let mut branch = ""
    let mut branch_bytes = 0
    let mut expected_bytes = -1
    let mut branch_count = 0
    let mut any_constrained_byte = false
    let mut branch_constrained = false
    while cursor < len(source) {
        let ch = str_char_at(source, cursor)
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            cursor = cursor + 1
            continue
        }
        if ch == "|" or ch == ")" {
            if branch_bytes == 0 { return YaraHexAlternation { branches: "", position: cursor, byte_length: 0, has_constrained_byte: false, valid: false } }
            if expected_bytes < 0 { expected_bytes = branch_bytes }
            if branch_bytes != expected_bytes or branch_count >= 4 {
                return YaraHexAlternation { branches: "", position: cursor, byte_length: 0, has_constrained_byte: false, valid: false }
            }
            if branch_constrained { any_constrained_byte = true }
            if branch_count > 0 { branches = branches + "|" }
            branches = branches + branch
            branch_count = branch_count + 1
            branch = ""
            branch_bytes = 0
            branch_constrained = false
            if ch == ")" {
                return YaraHexAlternation { branches: branches, position: cursor + 1, byte_length: expected_bytes, has_constrained_byte: any_constrained_byte, valid: branch_count >= 2 }
            }
            cursor = cursor + 1
            continue
        }
        if cursor + 1 >= len(source) {
            return YaraHexAlternation { branches: "", position: cursor, byte_length: 0, has_constrained_byte: false, valid: false }
        }
        if branch_bytes >= 16 {
            return YaraHexAlternation { branches: "", position: cursor, byte_length: 0, has_constrained_byte: false, valid: false }
        }
        let second = str_char_at(source, cursor + 1)
        if (ch != "?" and not _is_hex_pattern_digit(ch)) or (second != "?" and not _is_hex_pattern_digit(second)) {
            return YaraHexAlternation { branches: "", position: cursor, byte_length: 0, has_constrained_byte: false, valid: false }
        }
        if ch != "?" or second != "?" { branch_constrained = true }
        if branch_bytes > 0 { branch = branch + " " }
        let mut first_canonical = ch
        let mut second_canonical = second
        if ch != "?" { first_canonical = to_upper_tr(ch) }
        if second != "?" { second_canonical = to_upper_tr(second) }
        branch = branch + first_canonical + second_canonical
        if len(branch) > 8192 or len(branches) + len(branch) > 8192 {
            return YaraHexAlternation { branches: "", position: cursor, byte_length: 0, has_constrained_byte: false, valid: false }
        }
        branch_bytes = branch_bytes + 1
        cursor = cursor + 2
    }
    return YaraHexAlternation { branches: "", position: cursor, byte_length: 0, has_constrained_byte: false, valid: false }
}

// Normalize supported YARA hex jumps. Fixed `[N]` jumps expand to full-byte
// wildcards; one bounded `[N-M]` jump is encoded for the variable-length
// runtime matcher. Both forms and the compact range encoding are bounded to
// keep parsing and scanning work predictable.
fn _normalize_yara_hex_pattern(hex: str) -> str {
    let mut out = ""
    let mut range_left = ""
    let mut range_min = 0
    let mut range_max = 0
    let mut has_range = false
    let mut has_alternation = false
    let mut alt_prefix = ""
    let mut alt_branches = ""
    let mut i = 0
    let mut has_constrained_byte = false
    while i < len(hex) {
        let ch = str_char_at(hex, i)
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            i = i + 1
            continue
        }

        if ch == "[" {
            let lower = _parse_yara_jump_endpoint(hex, i + 1)
            if not lower.valid { return "" }
            let mut cursor = lower.position
            if cursor < len(hex) and str_char_at(hex, cursor) == "-" {
                if has_range or has_alternation { return "" }
                let upper = _parse_yara_jump_endpoint(hex, cursor + 1)
                if not upper.valid or upper.value < lower.value or upper.value > 64 {
                    return ""
                }
                if lower.value > 64 or upper.value - lower.value > 16 { return "" }
                cursor = upper.position
                if cursor >= len(hex) or str_char_at(hex, cursor) != "]" { return "" }
                has_range = true
                range_left = out
                range_min = lower.value
                range_max = upper.value
                out = ""
            } else {
                if lower.value < 1 or lower.value > 64 { return "" }
                if cursor >= len(hex) or str_char_at(hex, cursor) != "]" { return "" }
                let mut required = lower.value * 3 - 1
                if len(out) > 0 { required = required + 1 }
                // Keep normalized fixed-width input within the runtime's 8 KiB
                // hex-pattern limit to avoid scan-time parse failure.
                if len(out) + required > 8192 { return "" }
                let mut jump_index = 0
                while jump_index < lower.value {
                    if len(out) > 0 { out = out + " " }
                    out = out + "??"
                    jump_index = jump_index + 1
                }
                cursor = lower.position
            }
            i = cursor + 1
            continue
        }

        if ch == "(" {
            if has_alternation or has_range { return "" }
            let alternation = _parse_yara_hex_alternation(hex, i)
            if not alternation.valid { return "" }
            has_alternation = true
            alt_prefix = out
            alt_branches = alternation.branches
            if alternation.has_constrained_byte { has_constrained_byte = true }
            out = ""
            i = alternation.position
            continue
        }

        if i + 1 >= len(hex) { return "" }
        let first = ch
        let second = str_char_at(hex, i + 1)
        let valid_first = first == "?" or _is_hex_pattern_digit(first)
        let valid_second = second == "?" or _is_hex_pattern_digit(second)
        if not valid_first or not valid_second { return "" }
        let mut required = 2
        if len(out) > 0 { required = required + 1 }
        if len(out) + required > 8192 { return "" }
        if first != "?" or second != "?" { has_constrained_byte = true }
        if len(out) > 0 { out = out + " " }
        let mut canonical_first = first
        let mut canonical_second = second
        if first != "?" { canonical_first = to_upper_tr(first) }
        if second != "?" { canonical_second = to_upper_tr(second) }
        out = out + canonical_first + canonical_second
        i = i + 2
    }
    if not has_constrained_byte { return "" }
    if has_range {
        if len(range_left) == 0 or len(out) == 0 { return "" }
        let encoded = "hexrange:" + range_left + "|" + int_to_str(range_min) + "|" + int_to_str(range_max) + "|" + out
        if len(encoded) > 8192 { return "" }
        return encoded
    }
    if has_alternation {
        let mut remaining = alt_branches
        let mut encoded = "hexalt:"
        let mut branch_index = 0
        while branch_index < 4 and len(remaining) > 0 {
            let separator = str_index_of(remaining, "|")
            let mut branch = remaining
            if separator >= 0 {
                branch = str_sub(remaining, 0, separator)
                remaining = str_sub(remaining, separator + 1, len(remaining) - separator - 1)
            } else {
                remaining = ""
            }
            if branch_index > 0 { encoded = encoded + "|" }
            encoded = encoded + alt_prefix
            if len(alt_prefix) > 0 and len(branch) > 0 { encoded = encoded + " " }
            encoded = encoded + branch
            if len(out) > 0 {
                if len(alt_prefix) > 0 or len(branch) > 0 { encoded = encoded + " " }
                encoded = encoded + out
            }
            if len(encoded) > 8192 { return "" }
            branch_index = branch_index + 1
        }
        if branch_index < 2 or len(remaining) > 0 { return "" }
        return encoded
    }
    return out
}

// strings: bolumundeki "$id = ..." satirini ayristirir.
// Donus: ilk '=' isaretinden bolunebilen "$id=pattern" veya bos metin.
// Dinamik dizi dondurmemek LLVM erken-donus temizligiyle ilgili bir backend
// hatasini tetiklemeyi onler.
fn _parse_string_def(line: str) -> str {
    let t = str_trim(line)
    if not str_starts_with(t, "$") {
        return ""
    }
    let eq = str_index_of(t, "=")
    if eq < 0 {
        return ""
    }
    let id = str_trim(str_sub(t, 0, eq))
    let mut raw = str_trim(str_sub(t, eq + 1, len(t) - eq - 1))
    if len(id) == 0 or len(raw) == 0 {
        return ""
    }

    // Metin: temel kacislar ve desteklenen modifier'lar.
    if str_starts_with(raw, "\"") {
        let close = _find_unescaped_quote(str_sub(raw, 1, len(raw) - 1))
        if close < 0 {
            return ""
        }
        let tail = str_trim(str_sub(raw, close + 2, len(raw) - close - 2))
        let flags = _parse_text_modifier_flags(tail)
        if flags < 0 {
            return ""
        }
        let text = str_sub(raw, 1, close)
        let escape_error = _yara_escape_error(text)
        if len(escape_error) > 0 {
            return ""
        }
        if flags == 2 {
            // YARA'da ascii varsayilandir; acik yazimi hizli varsayilan yolda tut.
            return id + "=str:" + _decode_yara_text(text)
        }
        if flags > 0 {
            return id + "=str:flags:" + int_to_str(flags) + ":" + _decode_yara_text(text)
        }
        return id + "=str:" + _decode_yara_text(text)
    }

    // Hex: { 48 89 ?? 55 }
    if str_starts_with(raw, "{") {
        let close = str_index_of(raw, "}")
        if close < 0 {
            return ""
        }
        let hex = _normalize_yara_hex_pattern(str_sub(raw, 1, close - 1))
        if len(hex) == 0 { return "" }
        let tail = str_trim(str_sub(raw, close + 1, len(raw) - close - 1))
        if len(tail) > 0 {
            return ""
        }
        if str_starts_with(hex, "hexrange:") or str_starts_with(hex, "hexalt:") { return id + "=" + hex }
        return id + "=hex:" + hex
    }

    // Regex: /.../  — v0.1: desen olarak kullan
    if str_starts_with(raw, "/") {
        let close = str_index_of(str_sub(raw, 1, len(raw) - 1), "/")
        if close < 0 {
            return ""
        }
        let tail = str_trim(str_sub(raw, close + 2, len(raw) - close - 2))
        if len(tail) > 0 {
            return ""
        }
        let regex = str_sub(raw, 1, close)
        if len(regex_validate(regex)) > 0 {
            return ""
        }
        return id + "=regex:" + regex
    }
    return ""
}

// condition: satirini tek satira indirger.
fn _parse_condition(line: str) -> str {
    let t = str_trim(line)
    if not _starts_with_ci(t, "condition") {
        return ""
    }
    let colon = str_index_of(t, ":")
    if colon < 0 {
        return ""
    }
    return str_trim(str_sub(t, colon + 1, len(t) - colon - 1))
}

// Bu parser yalnizca bu condition alt kumesini dogru degerlendirir.
// Diger ifadeler scanner tarafinda varsayilan `any` gibi ele alinmasin.
fn _supported_condition(condition: str) -> bool {
    // Legacy shorthand used by the in-memory yara_rule API. Parsed YARA
    // conditions, including `N of them`, go through the condition parser.
    return condition == "any" or condition == "all"
}

fn _parse_meta_integer(raw: str) -> YaraMetaParse {
    let mut sign = 1
    let mut start = 0
    if len(raw) > 0 and str_char_at(raw, 0) == "-" {
        sign = -1
        start = 1
    }
    if start >= len(raw) {
        return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
    }

    let mut is_hex = false
    if start + 2 <= len(raw) and str_sub(raw, start, 2) == "0x" {
        is_hex = true
        start = start + 2
    } else if start + 2 <= len(raw) and str_sub(raw, start, 2) == "0X" {
        is_hex = true
        start = start + 2
    }
    if start >= len(raw) {
        return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
    }
    let digits = len(raw) - start
    if (is_hex and digits > 15) or (not is_hex and digits > 18) {
        return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
    }
    let mut integer_accumulator = 0
    let mut i = start
    while i < len(raw) {
        let ch = str_char_at(raw, i)
        let mut digit = -1
        if str_contains("0123456789", ch) {
            digit = str_to_int(ch)
        } else if is_hex {
            let lower = to_lower_tr(ch)
            let index = str_index_of("abcdef", lower)
            if index >= 0 { digit = index + 10 }
        }
        if digit < 0 or (not is_hex and digit >= 10) {
            return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
        }
        if is_hex { integer_accumulator = integer_accumulator * 16 + digit }
        else { integer_accumulator = integer_accumulator * 10 + digit }
        i = i + 1
    }
    return YaraMetaParse { key: "", stored_value: int_to_str(integer_accumulator * sign), value_type: "integer", valid: true }
}

fn _parse_meta_def(line: str) -> YaraMetaParse {
    let t = str_trim(line)
    let eq = str_index_of(t, "=")
    if eq <= 0 {
        return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
    }
    let key = str_trim(str_sub(t, 0, eq))
    if len(key) == 0 or not str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", str_char_at(key, 0)) {
        return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
    }
    let mut k = 1
    while k < len(key) {
        if not str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", str_char_at(key, k)) {
        return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
        }
        k = k + 1
    }

    let raw = str_trim(str_sub(t, eq + 1, len(t) - eq - 1))
    if raw == "true" or raw == "false" {
        return YaraMetaParse { key: key, stored_value: raw, value_type: "boolean", valid: true }
    }
    if str_starts_with(raw, "\"") {
        let close = _find_unescaped_quote(str_sub(raw, 1, len(raw) - 1))
        if close < 0 or close + 2 != len(raw) {
            return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
        }
        let value = str_sub(raw, 1, close)
        if len(_yara_escape_error(value)) > 0 or str_contains(value, "\\x") {
            return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
        }
        return YaraMetaParse { key: key, stored_value: _decode_yara_text(value), value_type: "string", valid: true }
    }
    let integer = _parse_meta_integer(raw)
    if integer.valid {
        return YaraMetaParse { key: key, stored_value: integer.stored_value, value_type: "integer", valid: true }
    }
    return YaraMetaParse { key: "", stored_value: "", value_type: "", valid: false }
}

// YARA'daki // yorumlarini string icinde kesme. # yorum imi degildir:
// kosulda #a, string'de #malware gibi kullanimi koru.
fn _strip_line_comment(line: str) -> str {
    let mut in_string = false
    let mut escaped = false
    let mut i = 0
    while i < len(line) {
        let ch = str_char_at(line, i)
        if escaped {
            escaped = false
        } else if in_string and ch == "\\" {
            escaped = true
        } else if ch == "\"" {
            in_string = not in_string
        } else if not in_string and ch == "/" {
            // Keep the bounds check separate: LLVM may eagerly evaluate the
            // right side of `and` and read past a trailing slash.
            if i + 1 < len(line) {
                if str_char_at(line, i + 1) == "/" {
                    return str_sub(line, 0, i)
                }
            }
        }
        i = i + 1
    }
    return line
}

// --- Ana ayristirici ---

fn parse_yara_rules(text: str) -> Result<YaraRuleSet, str> {
    if len(text) == 0 {
        return result_err_with<YaraRuleSet>("bos kural dosyasi", yara_ruleset_new())
    }

    let lines = str_split(text, "\n")
    let mut ruleset = yara_ruleset_new()

    let mut in_rule = false
    let mut in_meta = false
    let mut in_strings = false
    let mut in_condition = false
    let mut rule_name = ""
    let mut condition = "any of them"
    let mut condition_seen = false
    let mut condition_line = 0
    let mut rule = yara_rule_new("", "any of them")
    let mut rule_count = 0

    let mut i = 0
    while i < len(lines) {
        let raw_line = lines[i]
        let line = _strip_line_comment(raw_line)

        let trimmed = str_trim(line)

        if not in_rule {
            if _starts_with_ci(trimmed, "rule") {
                let name = _parse_rule_name(trimmed)
                if len(name) == 0 {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": kural adi eksik",
                        yara_ruleset_new())
                }
                in_rule = true
                in_meta = false
                in_strings = false
                in_condition = false
                rule_name = name
                condition = "any of them"
                condition_seen = false
                condition_line = 0
                rule = yara_rule_new(name, "any of them")
                let tag_colon = str_index_of(trimmed, ":")
                if tag_colon >= 0 {
                    let mut tag_text = str_trim(str_sub(trimmed, tag_colon + 1, len(trimmed) - tag_colon - 1))
                    let brace = str_index_of(tag_text, "{")
                    if brace >= 0 { tag_text = str_trim(str_sub(tag_text, 0, brace)) }
                    let mut tag_token = ""
                    let mut tag_pos = 0
                    while tag_pos <= len(tag_text) {
                        let mut ch = " "
                        if tag_pos < len(tag_text) { ch = str_char_at(tag_text, tag_pos) }
                        if ch == " " or ch == "\t" or tag_pos == len(tag_text) {
                            if len(tag_token) > 0 {
                                rule = yara_rule_add_tag(rule, tag_token)
                                tag_token = ""
                            }
                        } else if str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", ch) {
                            tag_token = tag_token + ch
                        } else {
                            return result_err_with<YaraRuleSet>(
                                "satir " + int_to_str(i + 1) + ": gecersiz rule etiketi",
                                yara_ruleset_new())
                        }
                        tag_pos = tag_pos + 1
                    }
                    if len(rule.tags) == 0 {
                        return result_err_with<YaraRuleSet>(
                            "satir " + int_to_str(i + 1) + ": rule etiketi eksik",
                            yara_ruleset_new())
                    }
                }
                rule_count = rule_count + 1
            } else if not _is_blank(trimmed) {
                return result_err_with<YaraRuleSet>(
                    "satir " + int_to_str(i + 1) + ": desteklenmeyen ust-duzey YARA yapisi: " + trimmed,
                    yara_ruleset_new())
            }
            i = i + 1
            continue
        }

        // Kural icindeyiz
        if _starts_with_ci(trimmed, "meta:") {
            in_meta = true
            in_strings = false
            in_condition = false
            i = i + 1
            continue
        }
        if _starts_with_ci(trimmed, "strings") {
            in_meta = false
            in_strings = true
            in_condition = false
            i = i + 1
            continue
        }
        if _starts_with_ci(trimmed, "condition") {
            in_meta = false
            in_strings = false
            condition_seen = true
            condition_line = i + 1
            condition = ""
            let c = _parse_condition(trimmed)
            if len(c) > 0 {
                condition = c
                in_condition = false
            } else {
                // Deger alt satirda: bir sonraki bos olmayan satiri al.
                in_condition = true
            }
            i = i + 1
            continue
        }

        if in_condition {
            if not _is_blank(trimmed) {
                condition = trimmed
                in_condition = false
            }
            i = i + 1
            continue
        }

        if in_meta {
            if not _is_blank(trimmed) {
                let meta = _parse_meta_def(trimmed)
                if not meta.valid {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": desteklenmeyen veya gecersiz meta degeri",
                        yara_ruleset_new())
                }
                let mut existing = 0
                while existing < len(rule.meta_keys) {
                    if rule.meta_keys[existing] == meta.key {
                        return result_err_with<YaraRuleSet>(
                            "satir " + int_to_str(i + 1) + ": yinelenen meta anahtari: " + meta.key,
                            yara_ruleset_new())
                    }
                    existing = existing + 1
                }
                rule = yara_rule_add_meta(rule, meta.key, meta.stored_value, meta.value_type)
            }
            i = i + 1
            continue
        }

        // Kapanis: yalnizca '}' iceren satir
        let t = trimmed
        if t == "}" {
            if len(rule_name) == 0 {
                return result_err_with<YaraRuleSet>(
                    "satir " + int_to_str(i + 1) + ": kural adi bos",
                    yara_ruleset_new())
            }
            if not condition_seen {
                return result_err_with<YaraRuleSet>(
                    "satir " + int_to_str(i + 1) + ": condition bolumu eksik",
                    yara_ruleset_new())
            }
            let mut prior_rule = 0
            while prior_rule < len(ruleset.rules) {
                if ruleset.rules[prior_rule].name == rule_name {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": yinelenen kural adi: " + rule_name,
                        yara_ruleset_new())
                }
                prior_rule = prior_rule + 1
            }
            if not _supported_condition(condition) {
                let condition_error = yara_condition_validate(condition, rule.pattern_names, rule.patterns)
                if len(condition_error) > 0 {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(condition_line) + ": " + condition_error,
                        yara_ruleset_new())
                }
            }
            if str_contains(condition, "#") {
                let mut pattern_index = 0
                while pattern_index < len(rule.patterns) {
                    if str_starts_with(rule.patterns[pattern_index], "regex:") {
                        return result_err_with<YaraRuleSet>(
                            "satir " + int_to_str(condition_line) + ": regex icin # desen sayimi desteklenmiyor",
                            yara_ruleset_new())
                    }
                    if str_starts_with(rule.patterns[pattern_index], "hexrange:") {
                        return result_err_with<YaraRuleSet>(
                            "satir " + int_to_str(condition_line) + ": degisken uzunluklu desen icin # sayimi desteklenmiyor",
                            yara_ruleset_new())
                    }
                    if str_starts_with(rule.patterns[pattern_index], "hexalt:") {
                        return result_err_with<YaraRuleSet>(
                            "satir " + int_to_str(condition_line) + ": alternation deseni icin # sayimi desteklenmiyor",
                            yara_ruleset_new())
                    }
                    pattern_index = pattern_index + 1
                }
            }
            // Toplanan pattern'lari KORU, yalnizca kosulu guncelle.
            let final_rule = YaraRule {
                name: rule_name,
                tags: rule.tags,
                meta_keys: rule.meta_keys,
                meta_values: rule.meta_values,
                meta_types: rule.meta_types,
                patterns: rule.patterns,
                pattern_names: rule.pattern_names,
                condition: condition,
                min_offset: rule.min_offset,
                max_offset: rule.max_offset
            }
            ruleset = yara_ruleset_add_rule(ruleset, final_rule)
            in_rule = false
            in_meta = false
            in_strings = false
            in_condition = false
            i = i + 1
            continue
        }

        if condition_seen {
            if not _is_blank(trimmed) {
                return result_err_with<YaraRuleSet>(
                    "satir " + int_to_str(i + 1) + ": cok satirli veya ek condition ifadesi desteklenmiyor",
                    yara_ruleset_new())
            }
            i = i + 1
            continue
        }

        if in_strings {
            let parsed = _parse_string_def(trimmed)
            if not _is_blank(trimmed) {
                if not str_starts_with(trimmed, "$") {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": desteklenmeyen strings girdisi",
                        yara_ruleset_new())
                }
                if len(parsed) == 0 {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": hatali veya desteklenmeyen string tanimi",
                        yara_ruleset_new())
                }
                let sep = str_index_of(parsed, "=")
                if sep < 0 {
                    return result_err_with<YaraRuleSet>(
                        "satir " + int_to_str(i + 1) + ": hatali string tanimi",
                        yara_ruleset_new())
                }
                rule = yara_rule_add_pattern(rule,
                    str_sub(parsed, 0, sep),
                    str_sub(parsed, sep + 1, len(parsed) - sep - 1))
            }
        } else if not _is_blank(trimmed) and not str_starts_with(trimmed, "{") {
            return result_err_with<YaraRuleSet>(
                "satir " + int_to_str(i + 1) + ": desteklenmeyen kural yapisi: " + trimmed,
                yara_ruleset_new())
        }

        i = i + 1
    }

    if in_rule {
        return result_err_with<YaraRuleSet>(
            "kural kapatilmadi (eksik '}'): " + rule_name, yara_ruleset_new())
    }
    if rule_count == 0 {
        return result_err_with<YaraRuleSet>("hic kural bulunamadi", yara_ruleset_new())
    }
    return result_ok<YaraRuleSet>(ruleset)
}
