# Axiom (λx) - Ornek 5: Gercek Zamanli Ag ve Port Tarayici (Native Real Scanner)
# Veri Yapilari (Structs), Dinamik Diziler (Arrays) ve POSIX Soket Kutuphanesi

struct TargetHost {
    host: str,
    port: int
}

struct ScanSummary {
    target: str,
    ports_scanned: int,
    open_count: int,
    elapsed_ms: int
}

fn probe_port(host: str, port: int) -> int
    requires port >= 1 and port <= 65535
    ensures return == 0 or return == 1
{
    let fd = tcp_connect(host, port)
    if fd >= 0 {
        print("[ACIK PORT BULUNDU] ->", host, ":", port)
        # HTTP portu ise basit bir HEAD istegi gonderip banner yakala
        if port == 80 or port == 8080 {
            let sent = tcp_send(fd, "HEAD / HTTP/1.0\r\nHost: localhost\r\n\r\n")
            if sent > 0 {
                let banner = tcp_recv(fd, 128)
                if len(banner) > 0 {
                    print("  Banner:", banner)
                }
            }
        }
        socket_close(fd)
        return 1
    }
    return 0
}

fn run_scanner(target_ip: str, port_list: int[]) -> ScanSummary
    requires len(target_ip) > 0
    ensures return.ports_scanned >= 0
{
    let total_ports = len(port_list)
    print("--------------------------------------------------")
    print("AXIOM GUVENLIK TARAYICISI CALISTIRILIYOR...")
    print("Hedef IP:", target_ip)
    print("Taranacak Port Sayisi:", total_ports)
    print("--------------------------------------------------")

    let start_time = time_now_ms()
    let mut open_found = 0

    for i in 0..total_ports {
        let current_port = port_list[i]
        let status = probe_port(target_ip, current_port)
        if status == 1 {
            open_found = open_found + 1
        }
    }

    let end_time = time_now_ms()
    let elapsed = end_time - start_time

    let summary = ScanSummary {
        target: target_ip,
        ports_scanned: total_ports,
        open_count: open_found,
        elapsed_ms: elapsed
    }
    return summary
}

fn main() -> int {
    print("==================================================")
    print("   AXIOM (λx) POSIX HIGH-PERFORMANCE SCANNER    ")
    print("==================================================")

    # Taranacak kritik port dizisi
    let ports = [21, 22, 80, 443, 8080, 9999]

    # Struct ornegi olusturma
    let initial_target = TargetHost {
        host: "127.0.0.1",
        port: 80
    }
    print("Yapilandirilan Ilk Hedef:", initial_target.host, ":", initial_target.port)

    # Taramayi baslat
    let report = run_scanner(initial_target.host, ports)

    print("==================================================")
    print("Tarama Sonuclari:")
    print("  Hedef Host    :", report.target)
    print("  Taranan Port  :", report.ports_scanned)
    print("  Acik Portlar  :", report.open_count)
    print("  Gecen Sure(ms):", report.elapsed_ms)
    print("==================================================")

    # Guvenlik ve mantik dogrulamalari
    verify report.ports_scanned == len(ports), "Taranan port sayisi dizi boyutuyla esit olmalidir!"
    verify report.elapsed_ms >= 0, "Gecen sure negatif olamaz!"

    print("Axiom Real Scanner basariyla tamamlandi.")
    return 0
}
