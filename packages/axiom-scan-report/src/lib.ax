// Reusable wording for numeric scan-summary counts.
// This helper labels counts; it does not classify files or determine safety.

fn report_label(total_matches: int, high_severity_matches: int) -> str
requires total_matches >= 0
requires high_severity_matches >= 0
requires high_severity_matches <= total_matches
{
    if high_severity_matches > 0 {
        return "high_severity_findings"
    }
    if total_matches > 0 {
        return "findings"
    }
    return "no_findings"
}
