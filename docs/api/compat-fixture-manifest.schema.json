{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaminakoai/axiom/blob/master/docs/api/compat-fixture-manifest.schema.json",
  "title": "Axiom compatibility release fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "source_examples",
    "package_projects",
    "scanner_schemas",
    "scanner_cases"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source_examples": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceExample" }
    },
    "package_projects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/packageProject" }
    },
    "scanner_schemas": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scannerSchema" }
    },
    "scanner_cases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scannerCase" }
    }
  },
  "anyOf": [
    { "properties": { "source_examples": { "minItems": 1 } } },
    { "properties": { "package_projects": { "minItems": 1 } } },
    { "properties": { "scanner_cases": { "minItems": 1 } } }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "backends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["c", "llvm"] }
    },
    "sourceExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "sha256", "backends", "stdout", "exit_code"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "backends": { "$ref": "#/$defs/backends" },
        "stdout": { "type": "string" },
        "exit_code": { "type": "integer" }
      }
    },
    "packageProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "tree_sha256", "entry", "backends", "stdout", "exit_code"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "root": { "type": "string", "minLength": 1 },
        "tree_sha256": { "$ref": "#/$defs/sha256" },
        "entry": { "type": "string", "minLength": 1 },
        "backends": { "$ref": "#/$defs/backends" },
        "stdout": { "type": "string" },
        "exit_code": { "type": "integer" }
      }
    },
    "scannerSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scannerCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "rules", "rules_sha256", "target", "target_sha256",
        "expected_json", "expected_json_sha256", "schema_id", "backends", "exit_code"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rules": { "type": "string", "minLength": 1 },
        "rules_sha256": { "$ref": "#/$defs/sha256" },
        "target": { "type": "string", "minLength": 1 },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "expected_json": { "type": "string", "minLength": 1 },
        "expected_json_sha256": { "$ref": "#/$defs/sha256" },
        "schema_id": { "$ref": "#/$defs/id" },
        "backends": { "$ref": "#/$defs/backends" },
        "exit_code": { "type": "integer" }
      }
    }
  }
}
